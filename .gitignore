.DS_Store
.claude/
.pytest_cache/

# Public-boundary guards: old archive copies and local env files must not drift
# into the deliverable workspace.
/ArchiveRosettaBitcoin/
/rosetta-bitcoin/
/rosetta-bitcoin-portal/
/rosetta-bitcoin-book/
/rosetta-bitcoin-audio/
/rosetta-java-node/
/.env
/.env.*
!/.env.example

# Node implementation directories are root-owned source. Ignore only generated
# runtime/build/dependency artifacts under them.
/Nodes/*/data/
/Nodes/*/data-*/
/Nodes/*/blocks/
/Nodes/*/chainstate-rocksdb/
/Nodes/*/operational-*/
/Nodes/*/utxo-*/
/Nodes/*/bitcoin-core-testnet4/
/Nodes/*/.venv/
/Nodes/*/.venv-*/
/Nodes/*/venv/
/Nodes/*/node_modules/
/Nodes/*/dist/
/Nodes/*/build/
/Nodes/*/build-*/
/Nodes/*/.build/
/Nodes/*/target/
/Nodes/*/_build/
/Nodes/*/deps/
/Nodes/*/bin/
/Nodes/*/obj/
/Nodes/*/.pytest_cache/
/Nodes/*/.mypy_cache/
/Nodes/*/.vitest/
/Nodes/*/coverage/
/Nodes/*/.benchmark-results/
/Nodes/*/.mojo-docs/
/Nodes/*/*.log
/Nodes/*/*.db
/Nodes/*/*.sqlite
/Nodes/*/*.sqlite3
/Nodes/*/*.db-journal
/Nodes/*/*.db-wal
/Nodes/*/*.db-shm
/Nodes/*/*.lock
!/Nodes/Elixir/mix.lock
/Nodes/*/*.pid

# Shared scratch, if any lands at the workspace root.
/data/
/reports/
*.log
*.db
!/Project/project.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.lock
*.pid
__pycache__/
*.py[cod]

# Generated dependency/build trees if surfaced outside ignored port repos.
node_modules/
dist/
build/
build-*/
target/
_build/
deps/
.venv/
venv/

# Root-owned reporting scratch.
/Project/tmp/
/Project/.campaigns/

# C# Docker proof scratch; canonical proof JSON lives under Nodes/Shared.
/Nodes/CSharp/.docker-csharp-proof-*

# Elixir Docker proof scratch; canonical proof JSON lives under Nodes/Shared.
/Nodes/Elixir/.docker-elixir-*

# Build caches (defense in depth; ports also ignore locally)
/Nodes/*/.zig-cache/
/Project/logs/
