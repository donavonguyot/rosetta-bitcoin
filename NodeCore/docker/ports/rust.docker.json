    "script_corpus_result": "NodeCore/conformance/results/rust_script_corpus_docker_2026-06-03.json",
    "local_reference_result": "NodeCore/conformance/results/rust_local_reference_docker_sync_2026-06-03.json",
    "notes": "Rust proof_partial: storage/status/Docker smoke, native crypto vectors, native 45/45 script corpus, and bounded local-reference replay through height 10000 pass. Live P2P sync, tip maintenance, and binary-gate completion remain follow-up work."
