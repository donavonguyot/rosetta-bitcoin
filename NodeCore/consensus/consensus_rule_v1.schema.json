{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodecore.local/consensus/consensus_rule_v1.schema.json",
  "title": "NodeCore Consensus Rule v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "rule_id",
    "category",
    "title",
    "chain",
    "status",
    "fixture_ids",
    "required_rules",
    "tags",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "rule_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
    "category": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "chain": { "type": "string", "minLength": 1 },
    "status": { "enum": ["candidate", "fixture_backed", "blocker_backed", "proved"] },
    "fixture_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "first_observed": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["port", "artifact", "result"],
        "properties": {
          "port": { "type": "string", "minLength": 1 },
          "artifact": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "minLength": 1 },
          "fixture_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
