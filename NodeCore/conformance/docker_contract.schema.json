{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rosettabitcoin.local/NodeCore/conformance/docker_contract.schema.json",
  "title": "Docker Contract Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "port",
    "captured_at",
    "manifest",
    "runtime_surface",
    "docker_status",
    "images",
    "volumes",
    "targets",
    "peer_results",
    "supervisor_tick_sample",
    "result",
    "failures"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "port": { "type": "string" },
    "captured_at": { "type": "string" },
    "manifest": { "type": "string" },
    "runtime_surface": {
      "type": "string",
      "enum": ["docker", "supervisor", "reference", "unknown"]
    },
    "docker_status": {
      "type": "string",
      "enum": ["missing", "daemon_only", "proof_partial", "supervisor_partial", "contract_passed", "non_compliant"]
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "runtime", "os_family"],
      "properties": {
        "base": { "type": ["string", "null"] },
        "runtime": { "type": ["string", "null"] },
        "os_family": { "type": ["string", "null"] }
      }
    },
    "volumes": {
      "type": "object",
      "additionalProperties": { "type": ["string", "null"] }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "result", "exit_code"],
        "properties": {
          "name": { "type": "string" },
          "command": { "type": ["string", "null"] },
          "result": { "type": "string", "enum": ["passed", "failed", "skipped", "missing"] },
          "exit_code": { "type": ["integer", "null"] },
          "failure": { "type": "string" }
        }
      }
    },
    "peer_results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_reference", "external_manual", "external_seed"],
      "properties": {
        "local_reference": { "$ref": "#/$defs/peer_result" },
        "external_manual": { "$ref": "#/$defs/peer_result" },
        "external_seed": { "$ref": "#/$defs/peer_result" }
      }
    },
    "supervisor_tick_sample": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "result": { "type": "string", "enum": ["passed", "failed", "partial", "missing"] },
    "failures": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "peer_result": {
      "type": "object",
      "additionalProperties": true,
      "required": ["supported", "result", "peer"],
      "properties": {
        "supported": { "type": "boolean" },
        "result": { "type": "string", "enum": ["passed", "failed", "skipped", "missing"] },
        "peer": { "type": ["string", "null"] }
      }
    }
  }
}
