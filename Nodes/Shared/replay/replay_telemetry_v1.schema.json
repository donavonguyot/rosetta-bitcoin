{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shared.local/replay/replay_telemetry_v1.schema.json",
  "title": "Shared Replay Telemetry v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_kind",
    "run_id",
    "implementation",
    "port",
    "runtime_surface",
    "replay_mode",
    "chain",
    "target_height",
    "validated_height",
    "result",
    "stage_totals_ms"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "shared.replay_telemetry" },
    "run_id": { "type": "string", "minLength": 1 },
    "implementation": { "type": "string", "minLength": 1 },
    "port": { "type": "string", "minLength": 1 },
    "runtime_surface": { "type": "string", "minLength": 1 },
    "replay_mode": { "type": "string", "minLength": 1 },
    "chain": { "type": "string", "minLength": 1 },
    "target_height": { "type": "integer", "minimum": 0 },
    "validated_height": { "type": "integer", "minimum": 0 },
    "validated_hash": { "type": ["string", "null"] },
    "stored_block_height": { "type": ["integer", "null"], "minimum": 0 },
    "header_height": { "type": ["integer", "null"], "minimum": 0 },
    "result": { "enum": ["passed", "failed", "blocked", "unknown"] },
    "current_blocker": {},
    "elapsed_ms": { "type": ["integer", "null"], "minimum": 0 },
    "stage_totals_ms": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "slow_blocks": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "script_threads": { "type": ["integer", "null"], "minimum": 1 },
    "crypto_context_mode": { "type": ["string", "null"] },
    "profile_paths": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "progress_samples": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "resource_samples": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    }
  }
}
