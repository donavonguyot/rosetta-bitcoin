{
  "manifest_version": 1,
  "port": "java",
  "status": "supervisor_partial",
  "paths": {
    "root": "Nodes/Java",
    "dockerfile": "Nodes/Java/docker/Dockerfile",
    "compose": "Nodes/Java/docker/docker-compose.yml",
    "dockerignore": "Nodes/Java/docker/.dockerignore"
  },
  "images": {
    "base": "maven:3.9.11-eclipse-temurin-21",
    "runtime": "eclipse-temurin:21-jre",
    "os_family": "Debian-family Temurin image",
    "package_manager": "Maven/BuildKit cache plus apt in base image",
    "native_dependencies": [
      "rocksdbjni via Maven",
      "secp256k1 native backend when enabled"
    ]
  },
  "volumes": {
    "data": "jbitnode_data",
    "proof": "jbitnode_proof_data",
    "proof_50k": "jbitnode_50k_proof_data",
    "proof_100k": "jbitnode_100k_proof_data",
    "supervisor": "jbitnode_sync_data"
  },
  "commands": {
    "docker_config": "cd Nodes/Java && docker compose --env-file ../Shared/docker/reference_topology.env -f docker/docker-compose.yml config",
    "docker_build": "cd Nodes/Java && make docker-build",
    "docker_warm": "cd Nodes/Java && make docker-warm",
    "docker_status": "cd Nodes/Java && DOCKER_PROOF_VOLUME=jbitnode_sync_data SECP256K1_BACKEND=native docker compose --env-file ../Shared/docker/reference_topology.env -f docker/docker-compose.yml run --rm --no-deps jbitnode-sync-proof com.jbitnode.cli.DbStatus",
    "docker_status_100k": "cd Nodes/Java && DOCKER_PROOF_VOLUME=jbitnode_100k_proof_data SECP256K1_BACKEND=native make docker-java-proof-status",
    "docker_script_corpus": "cd Nodes/Java && make docker-script-corpus",
    "docker_proof_local": "cd Nodes/Java && make docker-java-native-crypto-proof",
    "docker_proof_10k": "cd Nodes/Java && make docker-java-supporting-10k-proof",
    "docker_proof_50k": "cd Nodes/Java && make docker-java-supporting-50k-proof",
    "docker_proof_100k": "cd Nodes/Java && make docker-java-primary-100k-proof",
    "docker_proof_post_100k_to_tip": "cd Nodes/Java && make docker-java-post-100k-to-tip-proof",
    "docker_proof_tip_once": null,
    "docker_tip_maintenance": "cd Nodes/Java && make docker-java-tip-maintenance",
    "docker_probe_external": "cd Nodes/Java && make docker-java-public-peer-probe",
    "docker_supervisor": "cd Nodes/Java && make docker-java-sync-supervisor",
    "docker_supervisor_status": "cd Nodes/Java && make docker-java-sync-status",
    "docker_supervisor_stop": "cd Nodes/Java && make docker-java-sync-stop",
    "docker_supervisor_resume": "cd Nodes/Java && make docker-java-sync-resume",
    "docker_smoke_once": "cd Nodes/Java && make docker-smoke-once"
  },
  "peer_modes": {
    "local_reference": {
      "supported": true,
      "command": "cd Nodes/Java && make docker-java-native-crypto-proof",
      "peer": "${REFERENCE_P2P_PEER}",
      "required_recorded_facts": [
        "peer",
        "validated_height",
        "header_height",
        "stored_block_height",
        "sync_status"
      ]
    },
    "external_manual": {
      "supported": true,
      "command": "cd Nodes/Java && PUBLIC_PEERS=<public-testnet4-peer:48333> make docker-java-public-peer-probe",
      "peer": "${PUBLIC_PEERS}",
      "required_recorded_facts": [
        "peer",
        "selected_peers",
        "attempted_peers",
        "disconnect_error_count",
        "reconnect_count",
        "peer_advertised_start_height",
        "local_advertised_start_height",
        "start_header_height",
        "end_header_height",
        "start_validated_height",
        "end_validated_height",
        "blocks_downloaded",
        "blocks_connected",
        "final_status"
      ]
    },
    "external_seed": {
      "supported": false,
      "command": null,
      "peer": null,
      "required_recorded_facts": [
        "selected_peer",
        "seed_source",
        "disconnects",
        "validated_height"
      ]
    }
  },
  "supervisor": {
    "stop_marker": ".jbitnode_supervisor_stop",
    "resume_marker": ".jbitnode_supervisor_resume",
    "poll_sec": 120,
    "check_sec": 5
  },
  "tick_json": {
    "required_fields": [
      "phase",
      "runtime_surface",
      "peer_mode",
      "peer",
      "validated_height",
      "header_height",
      "stored_block_height",
      "sync_status",
      "delta_since_last",
      "process_running",
      "current_blocker"
    ]
  },
  "proof_artifacts": {
    "docker_contract_result": null,
    "storage_result": "Nodes/Shared/conformance/results/java_rocksdb_docker_local_peer_sync_2026-06-01.json",
    "notes": "docker_proof_local, docker_proof_50k, and docker_proof_100k run local-reference Docker benchmark commands with native secp256k1, RocksDB, WAL enabled, rb.port_progress, and fresh proof volumes. Project builds current benchmark artifacts. post_100k_to_tip resumes the port-owned 100k proof volume as durable product state; Project builds current tip-readiness artifacts. docker_probe_external runs operator-supplied public testnet4 peer lists; docker-java-public-peer-probe emits only full_node_public_peer_sync_probe evidence, and docker-java-peer-rotation-probe emits only full_node_peer_rotation_reconnect evidence."
  },
  "known_caveats": [
    "Public external probe requires PUBLIC_PEERS; DNS seed selection is not implemented"
  ]
}
