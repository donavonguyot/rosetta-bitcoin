{
  "manifest_version": 1,
  "port": "rust",
  "status": "proof_partial",
  "paths": {
    "root": "Nodes/Rust",
    "dockerfile": "Nodes/Rust/docker/Dockerfile",
    "compose": "Nodes/Rust/docker/docker-compose.yml",
    "dockerignore": "Nodes/Rust/docker/.dockerignore"
  },
  "images": {
    "base": "rust:1-bookworm",
    "runtime": "debian:bookworm-slim",
    "os_family": "Debian",
    "package_manager": "apt plus cargo",
    "native_dependencies": ["librocksdb-dev/librocksdb7.8", "rust-secp256k1"]
  },
  "volumes": {
    "data": "rsbitnode_data",
    "proof": "rsbitnode_proof_data",
    "proof_50k": "rsbitnode_50k_proof_data",
    "proof_100k": "rsbitnode_100k_proof_data",
    "tuning_50k_to_100k": "rsbitnode_tuning_50k_to_100k_data",
    "external_probe": "rsbitnode_external_5k_probe_data",
    "supervisor": "rsbitnode_sync_data",
    "local_reference": "rsbitnode_local_reference_data"
  },
  "commands": {
    "docker_config": "cd Nodes/Rust && make docker-config",
    "docker_build": "cd Nodes/Rust && make docker-build",
    "docker_warm": "cd Nodes/Rust && make docker-warm",
    "docker_status": "cd Nodes/Rust && make docker-status",
    "docker_storage_proof": "cd Nodes/Rust && make docker-storage-proof",
    "docker_script_corpus": "cd Nodes/Rust && make docker-script-corpus",
    "docker_proof_local": "cd Nodes/Rust && make docker-proof-local",
    "docker_proof_10k": "cd Nodes/Rust && make docker-proof-10k",
    "docker_proof_50k": "cd Nodes/Rust && make docker-proof-50k",
    "docker_proof_100k": "cd Nodes/Rust && make docker-proof-100k",
    "docker_proof_tip_once": null,
    "docker_tip_maintenance": null,
    "docker_tuning_100k_from_50k": "cd Nodes/Rust && make docker-tuning-100k-from-50k",
    "docker_proof_rpc_replay": "cd Nodes/Rust && make docker-proof-rpc-replay",
    "docker_probe_external": "cd Nodes/Rust && DOCKER_EXTERNAL_P2P_PEER=<host:48333> make docker-probe-external",
    "docker_supervisor": null,
    "docker_supervisor_status": null,
    "docker_supervisor_stop": null,
    "docker_supervisor_resume": null,
    "docker_smoke_once": "cd Nodes/Rust && make docker-smoke-once"
  },
  "peer_modes": {
    "local_reference": {
      "supported": true,
      "command": "cd Nodes/Rust && make docker-proof-local",
      "peer": "${REFERENCE_P2P_PEER}",
      "required_recorded_facts": ["peer", "validated_height", "header_height", "stored_block_height", "sync_status"]
    },
    "local_reference_rpc": {
      "supported": true,
      "command": "cd Nodes/Rust && make docker-proof-rpc-replay",
      "peer": "http://host.docker.internal:48332",
      "required_recorded_facts": ["peer", "validated_height", "header_height", "stored_block_height", "sync_status"]
    },
    "external_manual": {
      "supported": true,
      "command": "cd Nodes/Rust && DOCKER_EXTERNAL_P2P_PEER=<host:48333> make docker-probe-external",
      "peer": "explicit testnet4 host:48333 via DOCKER_EXTERNAL_P2P_PEER",
      "required_recorded_facts": ["peer", "disconnects", "advertised_start_height", "validated_height"]
    },
    "external_seed": {
      "supported": false,
      "command": null,
      "peer": null,
      "required_recorded_facts": ["selected_peer", "seed_source", "disconnects", "validated_height"]
    }
  },
  "supervisor": {
    "stop_marker": ".rsbitnode_supervisor_stop",
    "resume_marker": ".rsbitnode_supervisor_resume",
    "poll_sec": 120,
    "check_sec": 5
  },
  "tick_json": {
    "required_fields": ["phase", "runtime_surface", "peer_mode", "peer", "validated_height", "header_height", "stored_block_height", "sync_status", "delta_since_last", "process_running", "current_blocker"]
  },
  "proof_artifacts": {
    "docker_contract_result": null,
    "storage_result": "Nodes/Shared/conformance/results/rust_storage_gate_docker_2026-06-03.json",
    "script_corpus_result": "Nodes/Shared/conformance/results/rust_script_corpus_docker_2026-06-03.json",
    "local_reference_debug_result": "Nodes/Rust/.benchmark-results/rust_docker_baseline_5k_benchmark_<YYYY-MM-DD>.json",
    "external_probe_result": "Nodes/Shared/conformance/results/rust_docker_external_5k_probe_<YYYY-MM-DD>.json",
    "notes": "Rust proof_partial: storage/status/Docker smoke, native crypto vectors, native 45/45 script corpus, bounded local-reference RPC replay, and official local Reference P2P gates. Active benchmark commands stream rb.port_progress; Project builds current benchmark artifacts. docker_proof_10k and the resumed 50k-to-100k lane remain diagnostic only."
  },
  "known_caveats": ["The local Reference P2P comparator is a bounded proof harness, not live tip maintenance", "External manual P2P is diagnostic network-readiness evidence and is not benchmark-ranked", "Bounded local-reference RPC proof is not live P2P sync or tip maintenance", "docker_smoke_once is a one-shot supervisor tick smoke, not persistent supervisor support", "Binary gate remains not_attempted"]
}
