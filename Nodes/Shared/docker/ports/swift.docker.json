{
  "manifest_version": 1,
  "port": "swift",
  "status": "proof_partial",
  "paths": {
    "root": "Nodes/Swift",
    "dockerfile": "Nodes/Swift/docker/Dockerfile",
    "compose": "Nodes/Swift/docker/docker-compose.yml",
    "dockerignore": "Nodes/Swift/docker/.dockerignore"
  },
  "images": {
    "base": "swift:6.0-bookworm",
    "runtime": "swift:6.0-bookworm",
    "os_family": "Debian-family Swift image",
    "package_manager": "apt plus SwiftPM",
    "native_dependencies": ["librocksdb-dev/librocksdb7.8", "libsecp256k1-dev/libsecp256k1-1"]
  },
  "volumes": {
    "data": "swiftbitnode_data",
    "proof": "swiftbitnode_proof_data",
    "supervisor": "swiftbitnode_supervisor_data"
  },
  "commands": {
    "docker_config": "cd Nodes/Swift && make docker-config",
    "docker_build": "cd Nodes/Swift && make docker-build",
    "docker_warm": "cd Nodes/Swift && make docker-warm",
    "docker_status": "cd Nodes/Swift && make docker-status",
    "docker_script_corpus": "cd Nodes/Swift && make docker-script-corpus",
    "docker_proof_local": "cd Nodes/Swift && make docker-proof-local",
    "docker_proof_10k": "cd Nodes/Swift && make docker-proof-10k",
    "docker_proof_50k": "cd Nodes/Swift && make docker-proof-50k",
    "docker_proof_100k": "cd Nodes/Swift && make docker-proof-100k",
    "docker_proof_tip_once": null,
    "docker_tip_maintenance": null,
    "docker_probe_external": null,
    "docker_supervisor": "cd Nodes/Swift && make docker-supervisor",
    "docker_supervisor_status": "cd Nodes/Swift && make docker-supervisor-status",
    "docker_supervisor_stop": "cd Nodes/Swift && make docker-supervisor-stop",
    "docker_supervisor_resume": "cd Nodes/Swift && make docker-supervisor-resume",
    "docker_smoke_once": "cd Nodes/Swift && make docker-smoke-once"
  },
  "peer_modes": {
    "local_reference": {
      "supported": true,
      "command": "cd Nodes/Swift && make docker-proof-local",
      "peer": "${REFERENCE_P2P_PEER}",
      "required_recorded_facts": ["peer", "validated_height", "header_height", "stored_block_height", "sync_status"]
    },
    "external_manual": {
      "supported": false,
      "command": null,
      "peer": null,
      "required_recorded_facts": ["peer", "disconnects", "advertised_start_height", "validated_height"]
    },
    "external_seed": {
      "supported": false,
      "command": null,
      "peer": null,
      "required_recorded_facts": ["selected_peer", "seed_source", "disconnects", "validated_height"]
    }
  },
  "supervisor": {
    "stop_marker": ".swiftbitnode_supervisor_stop",
    "resume_marker": ".swiftbitnode_supervisor_resume",
    "poll_sec": 120,
    "check_sec": 5
  },
  "tick_json": {
    "required_fields": ["phase", "runtime_surface", "peer_mode", "peer", "validated_height", "header_height", "stored_block_height", "sync_status", "delta_since_last", "process_running", "current_blocker"]
  },
  "proof_artifacts": {
    "script_corpus_result": "Nodes/Shared/conformance/results/swift_script_corpus_<YYYY-MM-DD>.json",
    "local_reference_result": "Nodes/Shared/conformance/results/swift_docker_baseline_5k_benchmark_<YYYY-MM-DD>.json",
    "diagnostic_10k_result": "Nodes/Shared/conformance/results/swift_docker_diagnostic_10k_benchmark_<YYYY-MM-DD>.json",
    "shakedown_50k_result": "Nodes/Shared/conformance/results/swift_docker_shakedown_50k_benchmark_<YYYY-MM-DD>.json",
    "performance_100k_result": "Nodes/Shared/conformance/results/swift_docker_performance_100k_benchmark_<YYYY-MM-DD>.json",
    "notes": "Swift proof_partial: native 45/45 script corpus and RocksDB-backed Docker status are present. Local Reference 5k and 50k are official bounded gates; docker_proof_10k remains diagnostic only. docker_proof_100k is wired for the performance_100k surface and must be run only after the current 5k/50k refresh gates pass."
  },
  "known_caveats": ["Swift supervisor is chunked local-reference catch-up, not external peer discovery", "Binary gate remains not_attempted until imported tip proof reaches current Reference tip"]
}
