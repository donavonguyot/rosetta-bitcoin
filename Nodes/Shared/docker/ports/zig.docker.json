{
  "manifest_version": 1,
  "port": "zig",
  "status": "proof_partial",
  "paths": {
    "root": "Nodes/Zig",
    "dockerfile": "Nodes/Zig/docker/Dockerfile",
    "compose": "Nodes/Zig/docker/docker-compose.yml",
    "dockerignore": "Nodes/Zig/docker/.dockerignore"
  },
  "images": {
    "base": "debian:bookworm-slim plus pinned Zig toolchain",
    "runtime": "debian:bookworm-slim",
    "os_family": "Debian",
    "package_manager": "apt plus Zig tarball",
    "native_dependencies": ["librocksdb-dev", "libsecp256k1-dev"]
  },
  "volumes": {
    "data": "zigbitnode_data",
    "proof": "zigbitnode_proof_data",
    "supervisor": "zigbitnode_supervisor_data"
  },
  "commands": {
    "docker_config": "cd Nodes/Zig && make docker-config",
    "docker_build": "cd Nodes/Zig && make docker-build",
    "docker_warm": "cd Nodes/Zig && make docker-warm",
    "docker_status": "cd Nodes/Zig && make docker-status",
    "docker_storage_proof": "cd Nodes/Zig && make docker-storage-proof",
    "docker_script_corpus": "cd Nodes/Zig && make docker-script-corpus",
    "docker_proof_local": "cd Nodes/Zig && make docker-proof-local",
    "docker_proof_10k": "cd Nodes/Zig && make docker-proof-10k",
    "docker_probe_external": null,
    "docker_supervisor": null,
    "docker_supervisor_status": null,
    "docker_supervisor_stop": null,
    "docker_supervisor_resume": null,
    "docker_smoke_once": "cd Nodes/Zig && make docker-smoke-once"
  },
  "peer_modes": {
    "local_reference": {
      "supported": true,
      "command": "cd Nodes/Zig && make docker-proof-local",
      "peer": "host.docker.internal:48333",
      "required_recorded_facts": ["peer", "validated_height", "header_height", "stored_block_height", "sync_status"]
    },
    "external_manual": {
      "supported": false,
      "command": null,
      "peer": null,
      "required_recorded_facts": ["peer", "disconnects", "advertised_start_height", "validated_height"]
    },
    "external_seed": {
      "supported": false,
      "command": null,
      "peer": null,
      "required_recorded_facts": ["selected_peer", "seed_source", "disconnects", "validated_height"]
    }
  },
  "supervisor": {
    "stop_marker": ".zigbitnode_supervisor_stop",
    "resume_marker": ".zigbitnode_supervisor_resume",
    "poll_sec": 120,
    "check_sec": 5
  },
  "tick_json": {
    "required_fields": ["phase", "runtime_surface", "peer_mode", "peer", "validated_height", "header_height", "stored_block_height", "sync_status", "delta_since_last", "process_running", "current_blocker"]
  },
  "proof_artifacts": {
    "storage_gate_result": "Nodes/Shared/conformance/results/zig_storage_gate_docker_<YYYY-MM-DD>.json",
    "script_corpus_result": "Nodes/Shared/conformance/results/zig_script_corpus_<YYYY-MM-DD>.json",
    "local_reference_result": "Nodes/Shared/conformance/results/zig_docker_supporting_5k_benchmark_<YYYY-MM-DD>.json",
    "supporting_10k_result": "Nodes/Shared/conformance/results/zig_docker_supporting_10k_benchmark_<YYYY-MM-DD>.json",
    "supporting_50k_result": "Nodes/Shared/conformance/results/zig_docker_supporting_50k_benchmark_<YYYY-MM-DD>.json",
    "notes": "Zig proof_partial scaffold owns native RocksDB and Docker surfaces. The script corpus verifier and local Reference P2P connect path remain explicit blockers until implemented."
  },
  "known_caveats": [
    "Zig script corpus loader is present but the native verifier is not yet 45/45",
    "Local Reference P2P proof command is contract-shaped but does not yet connect blocks",
    "Binary gate remains not_attempted"
  ]
}
