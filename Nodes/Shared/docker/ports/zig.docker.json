{
  "manifest_version": 1,
  "port": "zig",
  "status": "proof_partial",
  "paths": {
    "root": "Nodes/Zig",
    "dockerfile": "Nodes/Zig/docker/Dockerfile",
    "compose": "Nodes/Zig/docker/docker-compose.yml",
    "dockerignore": "Nodes/Zig/docker/.dockerignore"
  },
  "images": {
    "base": "debian:bookworm-slim plus pinned Zig toolchain",
    "runtime": "debian:bookworm-slim",
    "os_family": "Debian",
    "package_manager": "apt plus Zig tarball/BuildKit cache",
    "native_dependencies": [
      "librocksdb-dev",
      "libsecp256k1-dev"
    ]
  },
  "volumes": {
    "data": "zigbitnode_data",
    "proof": "zigbitnode_proof_data",
    "proof_50k": "zigbitnode_50k_proof_data",
    "proof_100k": "zigbitnode_100k_proof_data",
    "supervisor": "zigbitnode_supervisor_data"
  },
  "commands": {
    "docker_config": "cd Nodes/Zig && make docker-config",
    "docker_build": "cd Nodes/Zig && make docker-build",
    "docker_warm": "cd Nodes/Zig && make docker-warm",
    "docker_status": "cd Nodes/Zig && make docker-status",
    "docker_storage_proof": "cd Nodes/Zig && make docker-storage-proof",
    "docker_script_corpus": "cd Nodes/Zig && make docker-script-corpus",
    "docker_proof_local": "cd Nodes/Zig && make docker-proof-local",
    "docker_proof_10k": "cd Nodes/Zig && make docker-proof-10k",
    "docker_proof_50k": "cd Nodes/Zig && make docker-proof-50k",
    "docker_proof_100k": "cd Nodes/Zig && make docker-proof-100k",
    "docker_proof_post_100k_to_tip": "cd Nodes/Zig && make docker-proof-post-100k-to-tip",
    "docker_proof_tip_once": null,
    "docker_tip_maintenance": null,
    "docker_probe_external": null,
    "docker_supervisor": null,
    "docker_supervisor_status": null,
    "docker_supervisor_stop": null,
    "docker_supervisor_resume": null,
    "docker_smoke_once": "cd Nodes/Zig && make docker-smoke-once"
  },
  "peer_modes": {
    "local_reference": {
      "supported": true,
      "command": "cd Nodes/Zig && make docker-proof-local",
      "peer": "${REFERENCE_P2P_PEER}",
      "required_recorded_facts": [
        "peer",
        "validated_height",
        "header_height",
        "stored_block_height",
        "sync_status"
      ]
    },
    "external_manual": {
      "supported": false,
      "command": null,
      "peer": null,
      "required_recorded_facts": [
        "peer",
        "disconnects",
        "advertised_start_height",
        "validated_height"
      ]
    },
    "external_seed": {
      "supported": false,
      "command": null,
      "peer": null,
      "required_recorded_facts": [
        "selected_peer",
        "seed_source",
        "disconnects",
        "validated_height"
      ]
    }
  },
  "supervisor": {
    "stop_marker": ".zigbitnode_supervisor_stop",
    "resume_marker": ".zigbitnode_supervisor_resume",
    "poll_sec": 120,
    "check_sec": 5
  },
  "tick_json": {
    "required_fields": [
      "phase",
      "runtime_surface",
      "peer_mode",
      "peer",
      "validated_height",
      "header_height",
      "stored_block_height",
      "sync_status",
      "delta_since_last",
      "process_running",
      "current_blocker"
    ]
  },
  "proof_artifacts": {
    "storage_gate_result": "Nodes/Shared/conformance/results/zig_storage_gate_docker_<YYYY-MM-DD>.json",
    "script_corpus_result": "Nodes/Shared/conformance/results/zig_script_corpus_<YYYY-MM-DD>.json",
    "local_reference_debug_result": "Nodes/Zig/.benchmark-results/zig_docker_baseline_5k_benchmark_<YYYY-MM-DD>.json",
    "diagnostic_10k_result": "Nodes/Shared/conformance/results/zig_docker_diagnostic_10k_benchmark_<YYYY-MM-DD>.json",
    "shakedown_50k_debug_result": "Nodes/Zig/.benchmark-results/zig_docker_shakedown_50k_benchmark_<YYYY-MM-DD>.json",
    "performance_100k_debug_result": "Nodes/Zig/.benchmark-results/zig_docker_performance_100k_benchmark_<YYYY-MM-DD>.json",
    "notes": "Zig proof_partial owns native RocksDB, Docker surfaces, script corpus 45/45, and official local Reference P2P benchmark commands. Active benchmark commands stream rb.port_progress; Project builds current benchmark artifacts. post_100k_to_tip resumes the port-owned 100k proof volume as durable product state; Project builds current tip-readiness artifacts."
  },
  "known_caveats": [
    "Zig script corpus is 45/45 with engine=zig_native and delegated=false",
    "Live external P2P discovery and tip maintenance remain out of scope for proof_partial",
    "Binary gate remains not_attempted"
  ]
}
