{
  "manifest_version": 1,
  "port": "elixir",
  "status": "proof_partial",
  "paths": {
    "root": "Nodes/Elixir",
    "dockerfile": "Nodes/Elixir/docker/Dockerfile",
    "compose": "Nodes/Elixir/docker/docker-compose.yml",
    "dockerignore": "Nodes/Elixir/docker/.dockerignore"
  },
  "images": {
    "base": "elixir:1.16-otp-26",
    "runtime": "elixir:1.16-otp-26",
    "os_family": "Debian-family Elixir image",
    "package_manager": "apt plus mix",
    "native_dependencies": ["librocksdb-dev/librocksdb7.8", "libsecp256k1-dev/libsecp256k1-1"]
  },
  "volumes": {
    "data": "exbitnode_data",
    "proof": "exbitnode_proof_data",
    "supervisor": "exbitnode_sync_data"
  },
  "commands": {
    "docker_config": "cd Nodes/Elixir && make docker-config",
    "docker_build": "cd Nodes/Elixir && make docker-build",
    "docker_warm": "cd Nodes/Elixir && make docker-warm",
    "docker_status": "cd Nodes/Elixir && make docker-status",
    "docker_proof_local": "cd Nodes/Elixir && make docker-proof-local",
    "docker_storage_proof": "cd Nodes/Elixir && make docker-storage-proof",
    "docker_script_corpus": "cd Nodes/Elixir && make docker-script-corpus",
    "docker_probe_external": null,
    "docker_supervisor": "cd Nodes/Elixir && make docker-supervisor",
    "docker_supervisor_status": "cd Nodes/Elixir && make docker-supervisor-status",
    "docker_supervisor_stop": "cd Nodes/Elixir && make docker-supervisor-stop",
    "docker_supervisor_resume": "cd Nodes/Elixir && make docker-supervisor-resume",
    "docker_smoke_once": "cd Nodes/Elixir && make docker-smoke-once"
  },
  "peer_modes": {
    "local_reference": {
      "supported": true,
      "command": "cd Nodes/Elixir && make docker-proof-local",
      "peer": "host.docker.internal:48333",
      "required_recorded_facts": ["peer", "validated_height", "header_height", "stored_block_height", "sync_status"]
    },
    "external_manual": {
      "supported": false,
      "command": null,
      "peer": null,
      "required_recorded_facts": []
    },
    "external_seed": {
      "supported": false,
      "command": null,
      "peer": null,
      "required_recorded_facts": []
    }
  },
  "supervisor": {
    "stop_marker": ".exbitnode_supervisor_stop",
    "resume_marker": ".exbitnode_supervisor_resume",
    "poll_sec": 120,
    "check_sec": 5
  },
  "tick_json": {
    "required_fields": ["phase", "runtime_surface", "peer_mode", "peer", "validated_height", "header_height", "stored_block_height", "sync_status", "delta_since_last", "process_running", "current_blocker"]
  },
  "proof_artifacts": {
    "docker_contract_result": null,
    "storage_result": "Nodes/Shared/conformance/results/elixir_rocksdb_codec_v2_storage.json",
    "notes": "Docker build, status, bounded storage proof, one-shot supervisor smoke, and docker_proof_local for the supporting 5k local-reference P2P benchmark with WAL enabled, prefetch depth 4, parallel script verification, and a fresh proof volume."
  },
  "known_caveats": ["RocksDB store abstraction is isolated for native binding replacement", "External network probe command not standardized"]
}
