{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rosettabitcoin.local/Nodes/Shared/docker/docker_contract.schema.json",
  "title": "Docker Contract Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "port",
    "status",
    "paths",
    "images",
    "volumes",
    "commands",
    "peer_modes",
    "supervisor",
    "tick_json",
    "proof_artifacts",
    "known_caveats"
  ],
  "properties": {
    "manifest_version": { "type": "integer", "const": 1 },
    "port": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["missing", "daemon_only", "proof_partial", "supervisor_partial", "contract_passed", "non_compliant"]
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "dockerfile", "compose", "dockerignore"],
      "properties": {
        "root": { "type": "string" },
        "dockerfile": { "type": ["string", "null"] },
        "compose": { "type": ["string", "null"] },
        "dockerignore": { "type": ["string", "null"] }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "runtime", "os_family", "package_manager"],
      "properties": {
        "base": { "type": ["string", "null"] },
        "runtime": { "type": ["string", "null"] },
        "os_family": { "type": ["string", "null"] },
        "package_manager": { "type": ["string", "null"] },
        "native_dependencies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "volumes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "proof", "supervisor"],
      "properties": {
        "data": { "type": ["string", "null"] },
        "proof": { "type": ["string", "null"] },
        "proof_50k": { "type": ["string", "null"] },
        "proof_100k": { "type": ["string", "null"] },
        "supervisor": { "type": ["string", "null"] }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docker_config",
        "docker_build",
        "docker_status",
        "docker_proof_local",
        "docker_probe_external",
        "docker_supervisor",
        "docker_supervisor_status",
        "docker_supervisor_stop",
        "docker_supervisor_resume",
        "docker_smoke_once"
      ],
      "properties": {
        "docker_config": { "type": ["string", "null"] },
        "docker_build": { "type": ["string", "null"] },
        "docker_status": { "type": ["string", "null"] },
        "docker_status_100k": { "type": ["string", "null"] },
        "docker_proof_local": { "type": ["string", "null"] },
        "docker_proof_10k": { "type": ["string", "null"] },
        "docker_proof_50k": { "type": ["string", "null"] },
        "docker_proof_100k": { "type": ["string", "null"] },
        "docker_proof_post_100k_to_tip": { "type": ["string", "null"] },
        "docker_proof_tip_once": { "type": ["string", "null"] },
        "docker_tip_maintenance": { "type": ["string", "null"] },
        "docker_probe_external": { "type": ["string", "null"] },
        "docker_supervisor": { "type": ["string", "null"] },
        "docker_supervisor_status": { "type": ["string", "null"] },
        "docker_supervisor_stop": { "type": ["string", "null"] },
        "docker_supervisor_resume": { "type": ["string", "null"] },
        "docker_smoke_once": { "type": ["string", "null"] }
      }
    },
    "peer_modes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_reference", "external_manual", "external_seed"],
      "properties": {
        "local_reference": { "$ref": "#/$defs/peer_mode" },
        "external_manual": { "$ref": "#/$defs/peer_mode" },
        "external_seed": { "$ref": "#/$defs/peer_mode" }
      }
    },
    "supervisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop_marker", "resume_marker", "poll_sec", "check_sec"],
      "properties": {
        "stop_marker": { "type": ["string", "null"] },
        "resume_marker": { "type": ["string", "null"] },
        "poll_sec": { "type": ["integer", "null"] },
        "check_sec": { "type": ["integer", "null"] }
      }
    },
    "tick_json": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields"],
      "properties": {
        "required_fields": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 11
        }
      }
    },
    "proof_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docker_contract_result", "storage_result", "notes"],
      "properties": {
        "docker_contract_result": { "type": ["string", "null"] },
        "storage_result": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      }
    },
    "known_caveats": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "peer_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "command", "peer", "required_recorded_facts"],
      "properties": {
        "supported": { "type": "boolean" },
        "command": { "type": ["string", "null"] },
        "peer": { "type": ["string", "null"] },
        "required_recorded_facts": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
