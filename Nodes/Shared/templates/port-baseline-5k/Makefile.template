docker-config:
	docker compose -f docker/docker-compose.yml config >/dev/null

docker-build:
	docker compose -f docker/docker-compose.yml build

docker-warm: docker-build

docker-status:
	docker compose -f docker/docker-compose.yml run --rm {{port}} status --json

docker-script-corpus:
	docker compose -f docker/docker-compose.yml run --rm {{port}} script-corpus \
	  --manifest ../../Nodes/Shared/conformance/fixtures/scripts/manifest.json \
	  --output ../../Nodes/Shared/conformance/results/{{port}}_script_corpus_$(shell date +%F).json

docker-proof-local:
	docker compose -f docker/docker-compose.yml run --rm \
	  -e TARGET_HEIGHT=5000 \
	  -e HEADER_TARGET_HEIGHT=5000 \
	  -e PREFETCH_DEPTH=4 \
	  -e SCRIPT_RUNNER_MODE=parallel \
	  -e ROCKSDB_WAL_DISABLED=false \
	  -e FRESH_STATE=true \
	  -e PEER=host.docker.internal:48333 \
	  {{port}} proof-local \
	  --output ../../Nodes/Shared/conformance/results/{{port}}_docker_supporting_5k_benchmark_$(shell date +%F).json
