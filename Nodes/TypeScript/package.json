{
  "name": "tsbitnode",
  "version": "0.1.0",
  "description": "Binary-compatible Bitcoin full node in TypeScript (testnet4)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tsbitnode": "./dist/cli/node.js",
    "tsbitnode-sync": "./dist/cli/syncRunner.js",
    "tsbitnode-db": "./dist/cli/dbStatus.js",
    "tsbitnode-healthcheck": "./dist/cli/healthcheck.js",
    "tsbitnode-native-status": "./dist/cli/nativeStatus.js",
    "tsbitnode-storage-proof": "./dist/cli/storageProof.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli/node.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:snapshots": "node dist/scripts/exportSnapshots.js",
    "sync:batch": "node dist/scripts/syncBatchLoop.js",
    "sync:progress": "node dist/scripts/syncProgressReport.js",
    "survey:scripts": "node dist/scripts/scriptTemplateSurvey.js",
    "native:status": "node dist/cli/nativeStatus.js",
    "storage:proof": "node dist/cli/storageProof.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "bitcoin",
    "p2p",
    "testnet4",
    "full-node"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "rocksdb": "^5.2.1",
    "secp256k1": "^5.0.1"
  }
}
