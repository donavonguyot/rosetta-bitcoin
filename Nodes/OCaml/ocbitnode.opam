opam-version: "2.0"
synopsis: "OCaml follower foundation for RB testnet4 node proofs"
maintainer: "RB"
authors: "RB"
license: "MIT"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.11"}
  "yojson"
  "digestif"
  "secp256k1" {= "0.5.0"}
  "alcotest" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]

