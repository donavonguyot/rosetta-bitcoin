    // Empty input vector, one output: 4 + 1 + 1 + 8 + 5 + script + 4.
    let mut tx = Transaction { version: 1, inputs: vec![], outputs: vec![Output { amount: 0, script: vec![0; ENVELOPE-23] }], locktime: 0 };
    let b = tx.serialize(false).unwrap(); assert_eq!(b.len(), ENVELOPE);
