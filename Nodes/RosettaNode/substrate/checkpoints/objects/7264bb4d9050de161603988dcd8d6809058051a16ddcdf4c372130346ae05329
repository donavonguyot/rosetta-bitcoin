#[test]
fn transport_byte_pool_and_text_limits() {
    let request = decode_request("decode_exact", &vec![0; TRANSPORT_BYTES], "legacy", "");
    status(&request, Error::Admission);
    let request = decode_request("decode_exact", &vec![0; TRANSPORT_BYTES+1], "legacy", "");
    status(&request, Error::Transport);
    let mut tx = base();
    // The pool includes the 32-byte previous digest and one-byte output script.
    tx.inputs[0].witness = vec![vec![0; TRANSPORT_BYTES-33]];
    let body = json_transaction(&tx);
    assert!(process(&serialization(&body, false, "")).is_ok());
    tx.inputs[0].witness[0].push(0);
    status(&serialization(&json_transaction(&tx), false, ""), Error::Transport);
    let mut text = serialization(EMPTY_TX, false, ""); text.resize_for_test(TRANSPORT_TEXT);
    assert!(process(&text).is_ok());
    text.push(' '); status(&text, Error::Transport);
}

trait PadString { fn resize_for_test(&mut self, size: usize); }
impl PadString for String { fn resize_for_test(&mut self, size: usize) { self.extend(std::iter::repeat_n(' ', size-self.len())); } }

#[test]
fn json_parser_escapes_numbers_duplicates_and_depth() {
    let text = r#"{"str":"\"\\\/\b\f\n\r\t\u0041\ud83d\ude00","num":-1.2e+3,"x":1,"x":"last","a":[null,false,true,{"k":[]}]}"#;
    let j = json::parse(text).unwrap();
    assert_eq!(j.string(j.field(j.root,"str").unwrap()).unwrap(), "\"\\/\u{8}\u{c}\n\r\tA😀");
    assert_eq!(j.string(j.field(j.root,"x").unwrap()).unwrap(), "last");
    let mut deep = "[".repeat(20000); deep.push_str("null"); deep.push_str(&"]".repeat(20000));
    assert!(json::parse(&deep).is_ok());
    for bad in ["", "[", "{", "[1,]", "{\"x\":0,}", "[01]", "[+1]", "[.1]", "[-]", "[1.]", "[1e]", "[1e+]", "true false", "nul", "[truefalse]", r#""\x00""#, r#""\uD800""#, r#""\uDC00""#, r#""\uD800\u0041""#, r#""\uZZZZ""#, "\"a\nb\"", "{null:1}", "[1 2]", "{\"x\" 0}"] {
        assert!(matches!(json::parse(bad), Err(Error::Invalid)), "{bad}");
    }
    let escaped = serialization(EMPTY_TX, false, "").replace("serialize", r#"seria\u006cize"#).replace("version_bits", r#"version\u005fbits"#);
    assert!(process(&escaped).is_ok());
}

#[test]
fn bounded_line_transport_recovers_after_failure() {
    let mut stream = vec![b' '; TRANSPORT_TEXT+1];
    stream.extend(b"\n{}\r\n\n{}");
    let mut reader = io::BufReader::with_capacity(8192, stream.as_slice());
    let mut line = Vec::new();
    assert_eq!(read_request(&mut reader, &mut line).unwrap(), Some(Err(Error::Transport)));
    assert!(line.is_empty());
    assert_eq!(read_request(&mut reader, &mut line).unwrap(), Some(Ok(()))); assert_eq!(line, b"{}\r");
    assert_eq!(read_request(&mut reader, &mut line).unwrap(), Some(Ok(()))); assert!(line.is_empty());
    assert_eq!(read_request(&mut reader, &mut line).unwrap(), Some(Ok(()))); assert_eq!(line, b"{}");
    assert_eq!(read_request(&mut reader, &mut line).unwrap(), None);
}

// Deterministic property checks use only this implementation and synthetic data.
// They complement the manually encoded fixtures, rather than defining semantics.
struct Random(u64);
impl Random {
    fn next(&mut self) -> u64 { self.0 ^= self.0 << 13; self.0 ^= self.0 >> 7; self.0 ^= self.0 << 17; self.0 }
    fn bytes(&mut self, max: usize) -> Vec<u8> { let n = self.next() as usize % (max+1); (0..n).map(|_| self.next() as u8).collect() }
}

#[test]
fn synthetic_roundtrips_and_history_independence() {
    let mut rng = Random(0x613879e10f28cd45);
    for _ in 0..300 {
        let mut tx = Transaction { version: rng.next() as u32, locktime: rng.next() as u32, ..Transaction::default() };
        for _ in 0..1+rng.next()%5 {
            let mut i = input();
            i.digest = std::array::from_fn(|_| rng.next() as u8);
            i.index = rng.next() as u32; i.sequence = rng.next() as u32; i.script = rng.bytes(300);
            for _ in 0..rng.next()%4 { i.witness.push(rng.bytes(260)); }
            tx.inputs.push(i);
        }
        for _ in 0..rng.next()%5 { tx.outputs.push(Output { amount: rng.next() as i64, script: rng.bytes(300) }); }
        for include in [false, true] {
            let bytes = tx.serialize(include).unwrap();
            let (decoded, used) = transaction::decode(&bytes, 0, true, true, 4096).unwrap();
            assert_eq!(used, bytes.len());
            assert_eq!(decoded.serialize(include).unwrap(), bytes);
            if include { assert_eq!(decoded, tx); }
            else { assert!(decoded.inputs.iter().all(|i| i.witness.is_empty())); }
            let response = process(&serialization(&json_transaction(&decoded), include, "")).unwrap();
            assert_eq!(response, serialize_response(&bytes).unwrap());
        }
    }
}

#[test]
fn random_malformed_bytes_and_json_do_not_panic() {
    let mut rng = Random(0x294ec63fab51087d);
    for _ in 0..5000 {
        let bytes = rng.bytes(500);
        for mode in [false, true] {
            if let Ok((tx, used)) = transaction::decode(&bytes, 0, mode, false, 4096) {
                assert!(used <= bytes.len()); assert!(tx.serialize(false).is_ok());
            }
        }
        let text: String = bytes.iter().map(|b| (b & 0x7f) as char).collect();
        let _ = json::parse(&text);
    }
}
