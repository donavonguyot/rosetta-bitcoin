#[test]
fn compactsize_boundaries_and_transactional_failure() {
    for (n, encoded) in [
        (0, "00"), (1, "01"), (252, "fc"), (253, "fdfd00"), (254, "fdfe00"),
        (65535, "fdffff"), (65536, "fe00000100"), (4294967295, "feffffffff"),
        (4294967296, "ff0000000001000000"), (u64::MAX, "ffffffffffffffffff"),
    ] {
        let mut out = Vec::new(); transaction::compact(&mut out, n);
        assert_eq!(hex(&out), encoded);
        assert_eq!(out.len(), transaction::compact_length(n));
        for length in 0..out.len() {
            let mut r = Reader { bytes: &out[..length], at: 0 };
            assert_eq!(r.compact(), Err(Error::Malformed));
            assert_eq!(r.at, 0);
        }
        let consumed = out.len(); out.push(0xaa);
        let mut r = Reader { bytes: &out, at: 0 };
        assert_eq!(r.compact().unwrap(), n);
        assert_eq!(r.at, consumed);
    }
    for s in ["fd0000", "fdfc00", "fe00000000", "feffff0000", "ff0000000000000000", "ffffffffff00000000"] {
        let mut b = vec![0x99]; b.extend(unhex(s).unwrap());
        let mut r = Reader { bytes: &b, at: 1 };
        assert_eq!(r.compact(), Err(Error::Malformed), "{s}");
        assert_eq!(r.at, 1);
    }
}

#[test]
fn supplied_prefix_offsets_and_zero_flags() {
    let b = unhex("05000000000044332211aa").unwrap();
    let (tx, consumed) = transaction::decode(&b, 0, true, false, 0).unwrap();
    assert_eq!(consumed, 10); assert_eq!(tx.version, 5); assert_eq!(tx.locktime, 287454020);
    assert!(tx.inputs.is_empty() && tx.outputs.is_empty());
    assert_eq!(transaction::decode(&b, 0, true, true, 0), Err(Error::Malformed));
    let mut prefixed = vec![0xaa; 7]; prefixed.extend(&b);
    assert_eq!(transaction::decode(&prefixed, 7, true, false, 0).unwrap(), (tx, 10));
    assert_eq!(transaction::decode(&b, b.len(), true, false, 0), Err(Error::Malformed));
    assert_eq!(transaction::decode(&b, b.len()+1, true, false, 0), Err(Error::Invalid));
    let response = process(&decode_request("decode_prefix", &prefixed, "witness", r#", "offset":"7""#)).unwrap();
    assert!(response.contains(r#""consumed":"10""#));
}

#[test]
fn manual_signed_field_layout() {
    let mut bytes = vec![0xff; 4]; bytes.push(1);
    bytes.extend(0u8..32); bytes.extend([0, 0, 0, 0x80]);
    bytes.extend([2, 0xde, 0xad, 0x78, 0x56, 0x34, 0x12]);
    bytes.push(2);
    bytes.extend([0xff; 8]); bytes.push(0);
    bytes.extend([0, 0, 0, 0, 0, 0, 0, 0x80]); bytes.extend([1, 0xff]);
    bytes.extend([0xff; 4]);
    let (tx, used) = transaction::decode(&bytes, 0, false, true, 3).unwrap();
    assert_eq!(used, bytes.len()); assert_eq!(tx.version, u32::MAX);
    assert_eq!(tx.inputs[0].digest, std::array::from_fn(|i| i as u8));
    assert_eq!(tx.inputs[0].index, 0x80000000); assert_eq!(tx.inputs[0].sequence, 0x12345678);
    assert_eq!(tx.inputs[0].script, [0xde, 0xad]); assert_eq!(tx.locktime, u32::MAX);
    assert_eq!(tx.outputs[0].amount, -1); assert_eq!(tx.outputs[1].amount, i64::MIN);
    assert_eq!(tx.serialize(false).unwrap(), bytes);
}

fn manual_witness() -> Vec<u8> {
    let mut b = vec![2, 0, 0, 0, 0, 1, 2];
    b.extend([0; 36]); b.push(0); b.extend([0xff; 4]);
    b.extend([0x11; 32]); b.extend([1, 0, 0, 0, 0]); b.extend([0xff; 4]);
    b.extend([1, 42, 0, 0, 0, 0, 0, 0, 0, 0]);
    b.extend([0, 1, 0]); // first stack empty, second contains one empty item
    b.extend([0; 4]); b
}

#[test]
fn manual_witness_and_empty_item() {
    let bytes = manual_witness();
    // The same bytes have a distinct, valid legacy prefix interpretation.
    let (legacy, legacy_used) = transaction::decode(&bytes, 0, false, false, 1).unwrap();
    assert_eq!(legacy_used, 19);
    assert!(legacy.inputs.is_empty());
    assert_eq!(legacy.outputs, vec![Output { amount: 2, script: vec![] }]);
    assert_eq!(legacy.locktime, 0);
    assert_eq!(transaction::decode(&bytes, 0, false, true, 1), Err(Error::Malformed));
    let (tx, consumed) = transaction::decode(&bytes, 0, true, true, 4).unwrap();
    assert_eq!(consumed, bytes.len()); assert_eq!(tx.inputs.len(), 2);
    assert_eq!(tx.inputs[0].witness, Vec::<Vec<u8>>::new());
    assert_eq!(tx.inputs[1].witness, vec![Vec::<u8>::new()]);
    assert_eq!(tx.serialize(true).unwrap(), bytes);
    let stripped = tx.serialize(false).unwrap();
    assert_eq!(stripped.len()+5, bytes.len());
    assert_ne!(sha256::double(&stripped), sha256::double(&bytes));
    let structured = json_transaction(&tx);
    let response = process(&serialization(&structured, true, "")).unwrap();
    assert_eq!(response, serialize_response(&bytes).unwrap());
    status(&serialization(&structured, false, r#", "limits":{"max_items":"3"}"#), Error::Resource);
    let identify = process(&format!(r#"{{"op":"identify","transaction":{structured}}}"#)).unwrap();
    let j = json::parse(&identify).unwrap();
    for (key, expected) in [("full", hex(&bytes)), ("stripped", hex(&stripped)),
        ("txid_digest_order", hex(&sha256::double(&stripped))), ("wtxid_digest_order", hex(&sha256::double(&bytes)))] {
        assert_eq!(j.string(j.field(j.root, key).unwrap()).unwrap(), expected);
    }
}

#[test]
fn witness_superfluous_and_unknown_flags() {
    let good = manual_witness();
    let mut all_empty = good.clone();
    all_empty.remove(all_empty.len()-5); // remove the single empty item's length
    let n = all_empty.len(); all_empty[n-5] = 0; // make second stack empty
    assert_eq!(transaction::decode(&all_empty, 0, true, true, 0), Err(Error::Malformed));
    for flags in 2..=255 {
        let mut b = good.clone(); b[5] = flags;
        assert_eq!(transaction::decode(&b, 0, true, true, 0), Err(Error::Malformed), "flags {flags}");
    }
    let zero_inputs = unhex("010000000001000000000000").unwrap();
    assert_eq!(transaction::decode(&zero_inputs, 0, true, true, 4096), Err(Error::Malformed));
}

#[test]
fn malformed_beats_budget_and_exactness_beats_budget() {
    let bytes = unhex(WORKED).unwrap();
    for n in 0..bytes.len() {
        assert_eq!(transaction::decode(&bytes[..n], 0, false, true, 0), Err(Error::Malformed), "length {n}");
    }
    assert_eq!(transaction::decode(&bytes, 0, false, true, 1), Err(Error::Resource));
    let mut trailing = bytes.clone(); trailing.push(0);
    assert_eq!(transaction::decode(&trailing, 0, false, true, 0), Err(Error::Malformed));
    assert_eq!(transaction::decode(&trailing, 0, false, false, 0), Err(Error::Resource));
    let w = manual_witness();
    for n in 0..w.len() {
        assert_eq!(transaction::decode(&w[..n], 0, true, true, 0), Err(Error::Malformed), "witness length {n}");
    }
    assert_eq!(transaction::decode(&w, 0, true, true, 3), Err(Error::Resource));
}

#[test]
fn impossible_counts_and_lengths_are_malformed() {
    for b in [
        unhex("01000000ffffffffffffffffff0000000000").unwrap(),
        unhex("0100000000ffffffffffffffffff00000000").unwrap(),
        unhex("01000000fdfc000000000000").unwrap(),
    ] { assert_eq!(transaction::decode(&b, 0, false, false, 0), Err(Error::Malformed)); }
    let bytes = unhex(WORKED).unwrap();
    // Input script length, output count, output script length, input count.
    for pos in [41, 46, 55, 4] {
        let mut b = bytes.clone(); b[pos] = 252;
        assert_eq!(transaction::decode(&b, 0, false, false, 0), Err(Error::Malformed), "position {pos}");
    }
    let mut w = manual_witness(); let pos = w.len()-6; w[pos] = 252;
    assert_eq!(transaction::decode(&w, 0, true, true, 0), Err(Error::Malformed));
}

