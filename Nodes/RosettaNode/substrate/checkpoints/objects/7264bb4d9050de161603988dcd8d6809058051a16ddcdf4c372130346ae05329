#[test]
fn structured_shape_range_and_type_validation() {
    let request = serialization(WORKED_TX, false, "");
    assert!(process(&request).is_ok());
    for (from, to) in [
        (r#""version_bits":"1""#, r#""version_bits":"4294967296""#),
        (r#""version_bits":"1""#, r#""version_bits":1"#),
        (r#""locktime":"0""#, r#""locktime":"-1""#),
        (r#""previous_index":"0""#, r#""previous_index":"4294967296""#),
        (r#""sequence":"4294967295""#, r#""sequence":null"#),
        (r#""amount":"42""#, r#""amount":"9223372036854775808""#),
        (r#""script":"51""#, r#""script":"5""#),
        (r#""witness":[]"#, r#""witness":null"#),
        (r#""witness":[]"#, r#""witness":[0]"#),
        (r#""witness":[]"#, r#""witness":[],"extra":0"#),
        (r#""outputs":[{"amount":"42","script":"51"}]"#, r#""outputs":null"#),
        (r#""locktime":"0""#, r#""locktime":"0","extra":true"#),
        (r#""amount":"42""#, r#""amount":"42","extra":true"#),
    ] {
        assert!(request.contains(from), "fixture is missing replacement target {from}");
        status(&request.replace(from, to), Error::Invalid);
    }
    let bad_digest = WORKED_TX.replace(&"0".repeat(64), &"0".repeat(62));
    status(&serialization(&bad_digest, false, ""), Error::Invalid);
    let missing = WORKED_TX.replace(r#""sequence":"4294967295","#, "");
    status(&serialization(&missing, false, ""), Error::Invalid);
}

#[test]
fn request_envelope_and_limits() {
    for request in ["null", "[]", "{}", r#"{"op":"other"}"#, r#"{"op":"decode_exact","bytes":""}"#,
        r#"{"op":"decode_prefix","bytes":"","mode":"other"}"#,
        r#"{"op":"decode_prefix","bytes":"","mode":"legacy","offset":0}"#,
        r#"{"op":"decode_prefix","bytes":"","mode":"legacy","offset":"-1"}"#,
        r#"{"op":"decode_prefix","bytes":"","mode":"legacy","offset":"1"}"#] {
        status(request, Error::Invalid);
    }
    for extra in [r#", "limits":null"#, r#", "limits":[]"#, r#", "limits":{"max_items":"4097"}"#,
        r#", "limits":{"max_items":4096}"#, r#", "limits":{"max_items":"00"}"#] {
        status(&serialization(EMPTY_TX, false, extra), Error::Invalid);
    }
    for extra in ["", r#", "limits":{}"#, r#", "limits":{"max_items":"0"}"#,
        r#", "extra":{"irrelevant":[null,true,123,{}]},"limits":{"unused":true}"#] {
        assert!(process(&serialization(EMPTY_TX, false, extra)).is_ok());
    }
    let uppercase = decode_request("decode_exact", &unhex(WORKED).unwrap(), "legacy", "").replace("ffffffff", "FFFFFFFF");
    assert!(process(&uppercase).is_ok());
    // Offset is not part of decode_exact, so an extra offset is ignored.
    assert!(process(&decode_request("decode_exact", &unhex(WORKED).unwrap(), "legacy", r#", "offset":false"#)).is_ok());
}

