import "C"

import (
	"encoding/hex"
	"fmt"
	"unsafe"
)

type Result struct {
	Status       string `json:"status"`
	Consumed     string `json:"consumed"`
	FullSize     string `json:"full_size"`
	StrippedSize string `json:"stripped_size"`
	TxID         string `json:"txid_digest_order"`
	WTxID        string `json:"wtxid_digest_order"`
}

func verify(p *Payload) ([]Result, error) {
	sizes := make([]C.uint64_t, len(p.Items))
	flags := make([]C.uint32_t, 2*len(p.Items))
	native := make([]C.rn_result, len(p.Items))
	for i, item := range p.Items {
		sizes[i] = C.uint64_t(len(item.Hex) / 2)
		if item.Mode == "witness" {
			flags[2*i] = 1
		}
		if item.Operation == "exact" {
			flags[2*i+1] = 1
		}
	}
	var src *C.uchar
	if len(p.Raw) > 0 {
		src = (*C.uchar)(unsafe.Pointer(&p.Raw[0]))
	}
	rc := C.run_v1(src, C.uint64_t(len(p.Raw)), &sizes[0], &flags[0], C.uint64_t(len(sizes)), &native[0])
	if rc != 0 {
		return nil, fmt.Errorf("native verification failed: %d", int(rc))
	}
	results := make([]Result, len(native))
	for i := range native {
		r := &native[i]
		status := uint64(r.status)
		if status > 4 {
			return nil, fmt.Errorf("unknown native result status: %d", status)
		}
		// Normalize every error result, regardless of native scratch contents.
		if status != 0 {
			*r = C.rn_result{status: C.uint64_t(status)}
		}
		results[i] = Result{
			Status: decimal(status), Consumed: decimal(uint64(r.consumed)),
			FullSize: decimal(uint64(r.full_size)), StrippedSize: decimal(uint64(r.stripped_size)),
			TxID:  hex.EncodeToString(unsafe.Slice((*byte)(unsafe.Pointer(&r.txid[0])), 32)),
			WTxID: hex.EncodeToString(unsafe.Slice((*byte)(unsafe.Pointer(&r.wtxid[0])), 32)),
		}
	}
	return results, nil
}
