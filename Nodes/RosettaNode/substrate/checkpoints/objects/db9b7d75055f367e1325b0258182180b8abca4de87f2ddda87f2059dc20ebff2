mod json;
mod codec;
mod sha256;

use std::io::{self, BufRead, Write};
use codec::{Limits, Transaction, field, text, uint};
use json::{Json, object, string, decimal};

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum Error { InvalidRequest, MalformedEncoding, ResourceLimit, ExecutionFailure, TransportLimit, AdmissionLimit }
pub type Result<T> = std::result::Result<T, Error>;
impl Error {
    fn status(self) -> &'static str {
        match self {
            Self::InvalidRequest => "invalid_request", Self::MalformedEncoding => "malformed_encoding",
            Self::ResourceLimit => "resource_limit", Self::ExecutionFailure => "execution_failure",
            Self::TransportLimit => "transport_limit", Self::AdmissionLimit => "admission_limit",
        }
    }
    fn response(self) -> Json { object(vec![("status", string(self.status()))]) }
}

fn limits(request: &Json) -> Result<Limits> {
    match request.get("limits") {
        None | Some(Json::Null) => Ok(Limits::default()),
        Some(v) if v.is_object() => Ok(Limits {
            max_items: match v.get("max_items") { None => u64::MAX, Some(n) => uint(n)? },
        }),
        _ => Err(Error::InvalidRequest),
    }
}

fn handle(request: &Json) -> Result<Json> {
    let op = text(field(request, "op")?)?;
    let limits = limits(request)?;
    match op {
        "decode_prefix" | "decode_exact" => {
            let bytes = codec::unhex(text(field(request, "bytes")?)?)?;
            let witness_mode = match text(field(request, "mode")?)? {
                "legacy" => false, "witness" => true, _ => return Err(Error::InvalidRequest),
            };
            let offset = if op == "decode_prefix" {
                usize::try_from(uint(field(request, "offset")?)?).map_err(|_| Error::InvalidRequest)?
            } else { 0 };
            let (tx, consumed) = codec::decode(&bytes, offset, witness_mode, limits)?;
            if op == "decode_exact" && consumed != bytes.len() { return Err(Error::MalformedEncoding); }
            Ok(object(vec![("status", string("ok")), ("transaction", tx.to_json()), ("consumed", decimal(consumed))]))
        }
        "serialize" => {
            let tx = Transaction::from_json(field(request, "transaction")?)?;
            let include_witness = match field(request, "include_witness")? {
                Json::Bool(b) => *b, _ => return Err(Error::InvalidRequest),
            };
            let bytes = codec::serialize(&tx, include_witness, limits)?;
            Ok(object(vec![("status", string("ok")), ("bytes", string(codec::hex(&bytes)))]))
        }
        "identify" => {
            let tx = Transaction::from_json(field(request, "transaction")?)?;
            let stripped = codec::serialize(&tx, false, limits)?;
            let full = codec::serialize(&tx, true, limits)?;
            let txid = sha256::double(&stripped);
            let wtxid = if full == stripped { txid } else { sha256::double(&full) };
            let mut txid_display = txid;
            let mut wtxid_display = wtxid;
            txid_display.reverse();
            wtxid_display.reverse();
            Ok(object(vec![
                ("status", string("ok")),
                ("stripped", string(codec::hex(&stripped))),
                ("full", string(codec::hex(&full))),
                ("stripped_size", decimal(stripped.len())),
                ("full_size", decimal(full.len())),
                ("txid_digest_order", string(codec::hex(&txid))),
                ("txid_display_order", string(codec::hex(&txid_display))),
                ("wtxid_digest_order", string(codec::hex(&wtxid))),
                ("wtxid_display_order", string(codec::hex(&wtxid_display))),
            ]))
        }
        _ => Err(Error::InvalidRequest),
    }
}

fn process_line(line: &[u8]) -> Json {
    let result = (|| {
        let line = std::str::from_utf8(line).map_err(|_| Error::InvalidRequest)?;
        let request = json::parse(line).map_err(|e| match e {
            json::ParseError::Syntax => Error::InvalidRequest,
            json::ParseError::Depth => Error::AdmissionLimit,
            json::ParseError::Memory => Error::ResourceLimit,
        })?;
        handle(&request)
    })();
    result.unwrap_or_else(Error::response)
}

fn run() -> io::Result<()> {
    let stdin = io::stdin();
    let stdout = io::stdout();
    let mut input = stdin.lock();
    let mut output = io::BufWriter::new(stdout.lock());
    let mut line = Vec::new();
    loop {
        line.clear();
        let n = match input.read_until(b'\n', &mut line) {
            Ok(n) => n,
            Err(e) if e.kind() == io::ErrorKind::Interrupted => continue,
            Err(e) => return Err(e),
        };
        if n == 0 { break; }
        let response = std::panic::catch_unwind(|| process_line(&line)).unwrap_or_else(|_| Error::ExecutionFailure.response());
        output.write_all(response.encode().as_bytes())?;
        output.write_all(b"\n")?;
        output.flush()?;
    }
    Ok(())
}

fn main() {
    if let Err(error) = run() { eprintln!("JSON-lines I/O error: {error}"); std::process::exit(1); }
}

