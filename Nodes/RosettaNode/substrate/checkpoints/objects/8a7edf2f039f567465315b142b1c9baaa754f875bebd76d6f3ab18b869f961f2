		t.Fatalf("scan allocations: small=%g large=%g", first, second)
	}
}

func TestDeterministicRoundTrips(t *testing.T) {
	rng := rand.New(rand.NewSource(20260916))
	blob := func(n int) []byte { b := make([]byte, n); _, _ = rng.Read(b); return b }
	for iteration := 0; iteration < 300; iteration++ {
		tx := transaction{version: rng.Uint32(), locktime: rng.Uint32()}
		for i, n := 0, 1+rng.Intn(4); i < n; i++ {
			in := txInput{digest: blob(32), index: rng.Uint32(), script: blob(rng.Intn(300)), sequence: rng.Uint32()}
			for j, n := 0, rng.Intn(4); j < n; j++ {
				in.witness = append(in.witness, blob(rng.Intn(300)))
			}
			tx.inputs = append(tx.inputs, in)
		}
		for i, n := 0, rng.Intn(4); i < n; i++ {
			tx.outputs = append(tx.outputs, txOutput{amount: int64(rng.Uint64()), script: blob(rng.Intn(300))})
		}
		for _, witness := range []bool{false, true} {
			encoded := serialize(&tx, witness)
			decoded, consumed := decode(encoded, 0, witness, true, defaultItems)
			if consumed != len(encoded) || !bytes.Equal(serialize(&decoded, witness), encoded) {
				t.Fatalf("wire roundtrip %d", iteration)
			}
			want := tx.jsonObject()
			if !witness {
				for i := range want.Inputs {
					want.Inputs[i].Witness = []string{}
				}
			}
			if !reflect.DeepEqual(want, decoded.jsonObject()) {
				t.Fatalf("field roundtrip %d", iteration)
			}
			got := call(t, map[string]any{"op": "serialize", "transaction": tx.jsonObject(), "include_witness": witness})
			requireStatus(t, got, "ok")
			if got.Bytes != hex.EncodeToString(encoded) {
				t.Fatalf("structured roundtrip %d", iteration)
			}
		}
	}
}

func FuzzDecode(f *testing.F) {
	f.Add(unhex(f, fixtureBytes), false)
	f.Add(unhex(f, "05000000000044332211aa"), true)
	f.Add([]byte{}, false)
	f.Fuzz(func(t *testing.T, data []byte, witness bool) {
		if len(data) > admissionBytes {
			t.Skip()
		}
		mode := "legacy"
		if witness {
			mode = "witness"
		}
		got := decodeRequest(t, hex.EncodeToString(data), mode, false, "")
		switch got.Status {
		case "ok":
			encoded := call(t, map[string]any{"op": "serialize", "transaction": got.Transaction, "include_witness": witness})
			requireStatus(t, encoded, "ok")
			n, err := strconv.Atoi(got.Consumed)
			if err != nil || n > len(data) || encoded.Bytes != hex.EncodeToString(data[:n]) {
				t.Fatalf("accepted prefix did not reconstruct: %+v", got)
			}
		case "malformed_encoding", "resource_limit":
			requireStatus(t, got, got.Status)
		default:
			t.Fatal(fmt.Sprintf("unexpected decode status %q", got.Status))
		}
	})
}
