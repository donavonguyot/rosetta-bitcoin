    def test_v2_offsets_bitmap_and_v1_parity(self):
        raw = bytes.fromhex(item()["hex"])
        with Client(self.s.sock) as c:
            for count in (1, 2, 63, 64):
                for pattern in ("all", "none", "first", "last", "alternating"):
                    cases = []
                    expected_bitmap = 0
                    for n in range(count):
                        success = (pattern == "all" or pattern == "first" and n == 0
                                   or pattern == "last" and n == count - 1
                                   or pattern == "alternating" and n % 2 == 0)
                        if success:
                            # Unequal item lengths and trailing bytes exercise
                            # offsets and item-relative prefix consumption.
                            cases.append(item(raw + b"x" * n, operation="prefix"))
                            expected_bitmap |= 1 << n
                        else:
                            cases.append(item(b"\xff" * n))
                    old = self.native.evaluate(cases)
                    new, bitmap = self.native.evaluate(cases, abi=2)
                    self.assertEqual(new, old, (count, pattern))
                    self.assertEqual(bitmap, expected_bitmap, (count, pattern))
                    response = c.call("evaluate", items=cases, priority="high")
                    self.assertEqual(response["status"], "ok")
                    self.assertEqual(response["results"], old)
            # Exercise the persistent worker path with bit 63 set too.
            cases = [item(b"")] * 63 + [item()]
            self.assertEqual(c.call("submit", id="bitmap63", items=cases, priority="high")["status"], "accepted")
            self.assertEqual(terminal(c, "bitmap63")["results"], self.native.evaluate(cases))
        self.s.stop(); inspect(self.s.db)

