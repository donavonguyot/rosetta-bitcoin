    def test_storage_write_error_never_acknowledged(self):
        self.s.stop()
        # A kernel-enforced file-size failure exercises the real RocksDB error
        # path, without adding fault injection or barrier hooks to the service.
        def ignore_file_limit_signal(): signal.signal(signal.SIGXFSZ, signal.SIG_IGN)
        p = subprocess.Popen([SERVICE,str(self.s.db),str(self.s.sock)],stderr=subprocess.PIPE,preexec_fn=ignore_file_limit_signal)
        try:
            end = time.monotonic()+10
            while not self.s.sock.exists():
                self.assertIsNone(p.poll())
                self.assertLess(time.monotonic(),end); time.sleep(.002)
            with Client(self.s.sock) as c:
                resource.prlimit(p.pid,resource.RLIMIT_FSIZE,(0,0))
                with self.assertRaises((EOFError,ConnectionResetError,BrokenPipeError)):
                    c.call("submit",id="must-not-ack",items=[item()])
            self.assertNotEqual(p.wait(10),0)
            diagnostic = p.stderr.read()
            self.assertTrue(b"service fatal" in diagnostic or b"Assertion" in diagnostic,diagnostic)
            rows = inspect(self.s.db)
            self.assertNotIn("id/must-not-ack",rows)
            self.s.start(); self.s.stop(); inspect(self.s.db)
        finally:
            if p.poll() is None: p.kill(); p.wait(10)
            p.stderr.close()
    def test_native_transaction_resource_boundaries(self):
        entry = b"\0"*32 + b"\xff"*4 + b"\0" + b"\xff"*4
        cases = []
        for inputs in (4095,4096):
            tx = b"\x01\0\0\0\xfd" + struct.pack("<H",inputs) + entry*inputs + b"\x01" + b"\0"*8 + b"\0" + b"\0"*4
            cases.append(item(tx))
        cases.extend([item(large_transaction()),item(b"\0"*((4<<20)+1))])
        expected = self.native.evaluate(cases)
        self.assertEqual([x["status"] for x in expected],["0","2","0","3"])
        with Client(self.s.sock) as c:
            self.assertEqual(c.call("evaluate",items=cases)["results"],expected)
        self.s.stop(); inspect(self.s.db)
    def test_simultaneous_idempotent_admission(self):
        import threading
        barrier = threading.Barrier(8)
        def send(_):
            with Client(self.s.sock) as c:
                barrier.wait(10)
                return c.call("submit",id="shared-id",items=[item()])
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool: responses=list(pool.map(send,range(8)))
        self.assertEqual(sum(x["status"]=="accepted" for x in responses),1)
        self.assertEqual(sum(x["status"]=="existing" for x in responses),7)
        self.assertEqual({x["sequence"] for x in responses},{"1"})
        time.sleep(.05); self.s.stop()
        self.assertEqual(inspect(self.s.db)["meta/sequence"],b"1")
