    def test_actual_predecessor_datadir_upgrade(self):
        self.s.stop()
        fixture = ROOT / "tests" / "fixtures"
        archive = fixture / "v1-datadir.tar.gz"
        manifest = json.loads((fixture / "v1-manifest.json").read_text())
        self.assertEqual(hashlib.sha256(archive.read_bytes()).hexdigest(), manifest["archive_sha256"])
        with tempfile.TemporaryDirectory(prefix="upgrade-", dir=ROOT / "tmp") as directory:
            with tarfile.open(archive, "r:gz") as saved:
                # Pinned Python predates tarfile's extraction filters. This
                # locally captured, hash-checked fixture contains only db files.
                for member in saved.getmembers():
                    parts = Path(member.name).parts
                    self.assertTrue(parts and parts[0] == "db" and ".." not in parts)
                    self.assertTrue(member.isdir() or member.isfile())
                saved.extractall(directory)
            upgraded = Service(directory)
            before = inspect(upgraded.db)
            self.assertEqual({k: hashlib.sha256(v).hexdigest() for k, v in before.items()}, manifest["row_sha256"])
            self.assertEqual(before["meta/checkpoint"], b"1")
            self.assertEqual(before["meta/jobs"], b"3")
            for n in (2, 3, 4):
                self.assertEqual(json.loads(before[f"p/{n:020d}"])["priority"], "normal")
            try:
                upgraded.start()
                with Client(upgraded.sock) as c:
                    self.assertEqual(c.call("status", id="old-receipt")["job"], json.loads(before[f"r/{1:020d}"]))
                    self.assertEqual(terminal(c, "old-cancel")["state"], "cancelled")
                    for n, name in ((2, "old-running"), (4, "old-pending")):
                        pending = json.loads(before[f"p/{n:020d}"])
                        job = terminal(c, name)
                        self.assertEqual(job["digest"], pending["digest"])
                        self.assertEqual(job["results"], self.native.evaluate(pending["items"]))
                    self.assertEqual(c.call("submit", id="new-high", items=[item()], priority="high")["status"], "accepted")
                upgraded.stop()
                after = inspect(upgraded.db)
                self.assertEqual(after[f"r/{1:020d}"], before[f"r/{1:020d}"])
                self.assertEqual(after["meta/checkpoint"], b"5")
                for key in before:
                    if key.startswith("id/"): self.assertEqual(after[key], before[key])
                upgraded.start(); upgraded.stop(); self.assertEqual(inspect(upgraded.db), after)
            finally:
                upgraded.kill()

