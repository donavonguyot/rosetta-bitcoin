//! Coordinator-owned FIFO queues. Only a dispatch with both queues ready
//! advances the H,H,H,N cycle; cancelled/stale entries consume no turn.
use crate::wire::Priority;
use std::collections::VecDeque;

pub struct Scheduler<T> {
    high: VecDeque<T>,
    normal: VecDeque<T>,
    turn: u8,
}

impl<T> Scheduler<T> {
    pub fn new() -> Self {
        Self {
            high: VecDeque::new(),
            normal: VecDeque::new(),
            turn: 0,
        }
    }

    pub fn push(&mut self, priority: Priority, work: T) {
        match priority {
            Priority::High => self.high.push_back(work),
            Priority::Normal => self.normal.push_back(work),
        }
    }

    pub fn pop(&mut self, eligible: impl Fn(&T) -> bool) -> Option<T> {
        for queue in [&mut self.high, &mut self.normal] {
            while queue.front().is_some_and(|work| !eligible(work)) {
                queue.pop_front();
            }
        }
        match (self.high.is_empty(), self.normal.is_empty()) {
            (true, true) => None,
            (false, true) => self.high.pop_front(),
            (true, false) => self.normal.pop_front(),
            (false, false) => {
                let normal_turn = self.turn == 3;
                self.turn = (self.turn + 1) % 4;
                if normal_turn {
                    self.normal.pop_front()
                } else {
                    self.high.pop_front()
                }
            }
        }
    }

    pub fn is_empty(&self) -> bool {
        self.high.is_empty() && self.normal.is_empty()
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use Priority::{High, Normal};

    #[test]
    fn weighted_fifo() {
        let mut q = Scheduler::new();
        for i in 1..=12 {
            q.push(High, i);
            q.push(Normal, 100 + i);
        }
        let first: Vec<_> = (0..16).map(|_| q.pop(|_| true).unwrap()).collect();
        assert_eq!(
            first,
            [1, 2, 3, 101, 4, 5, 6, 102, 7, 8, 9, 103, 10, 11, 12, 104]
        );
        let rest: Vec<_> = std::iter::from_fn(|| q.pop(|_| true)).collect();
        assert_eq!(rest, (105..=112).collect::<Vec<_>>());
        assert!(q.is_empty());
    }

    #[test]
    fn normal_only_and_idle_preserve_partial_cycle() {
        let mut q = Scheduler::new();
        q.push(High, 1);
        q.push(Normal, 101);
        assert_eq!(q.pop(|_| true), Some(1));
        assert_eq!(q.pop(|_| true), Some(101));
        assert_eq!(q.pop(|_| true), None);
        for i in 2..=4 {
            q.push(High, i);
        }
        q.push(Normal, 102);
        let got: Vec<_> = std::iter::from_fn(|| q.pop(|_| true)).collect();
        assert_eq!(got, [2, 3, 102, 4]);
    }

    #[test]
    fn high_only_and_cancelled_front_preserve_normal_turn() {
        let mut q = Scheduler::new();
        for i in 1..=5 {
            q.push(High, i);
        }
        q.push(Normal, 101);
        for i in 1..=3 {
            assert_eq!(q.pop(|_| true), Some(i));
        }
        // The normal head is cancelled at its turn; the following high-only
        // dispatches must not spend that turn or dispatch the cancelled job.
        assert_eq!(q.pop(|&x| x != 101), Some(4));
        assert_eq!(q.pop(|_| true), Some(5));
        q.push(High, 6);
        q.push(Normal, 102);
        assert_eq!(q.pop(|_| true), Some(102));
        assert_eq!(q.pop(|_| true), Some(6));
        assert!(q.is_empty());
    }

    #[test]
    fn stale_entries_do_not_count_as_dispatches() {
        let mut q = Scheduler::new();
        for i in 0..8 {
            q.push(High, i);
            q.push(Normal, 100 + i);
        }
        let got: Vec<_> = std::iter::from_fn(|| q.pop(|&x| x % 2 != 0)).collect();
        assert_eq!(got, [1, 3, 5, 101, 7, 103, 105, 107]);
        assert!(q.is_empty());
    }
}
