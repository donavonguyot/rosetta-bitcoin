import difflib
import hashlib
import json
from pathlib import Path
import subprocess

root = Path('/workspace')
def command(*args):
    p = subprocess.run(args, capture_output=True, text=True, check=True)
    return p.stdout
files = [Path('build.sh'), *sorted(Path('src').glob('*.zig')), *sorted(Path('tests').glob('*'))]
files = [p for p in files if p.is_file()]
diffs = {}
for p in files:
    before_path = Path('tmp/baseline') / p
    before = before_path.read_text().splitlines() if before_path.exists() else []
    after = p.read_text().splitlines()
    added = removed = 0
    for tag, a, b, c, d in difflib.SequenceMatcher(a=before, b=after, autojunk=False).get_opcodes():
        if tag in ('replace', 'delete'): removed += b-a
        if tag in ('replace', 'insert'): added += d-c
    diffs[str(p)] = dict(added=added, removed=removed, category='tests' if str(p).startswith('tests/') else 'production')
sha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()
result = dict(versions={'zig': command('/opt/zig/zig','version').strip(),
                        'rocksdb': command('dpkg-query','-W','librocksdb7.8','librocksdb-dev')},
              elf=command('readelf','-h','service'), dynamic=command('readelf','-d','service'),
              symbols=[line for line in command('readelf','-Ws','service').splitlines() if 'rn_verify_' in line],
              diff=diffs, generated_source_lines=0,
              artifacts={p:dict(sha256=sha(p),bytes=Path(p).stat().st_size) for p in ['service','tmp/baseline/service','tmp/service-debug']},
              adapter_sha256=sha('/adapter/librosetta.so'))
for category in ('production','tests'):
    result[category+'_lines']={k:sum(v[k] for v in diffs.values() if v['category']==category) for k in ('added','removed')}
assert 'AArch64' in result['elf']
assert 'librosetta.so' in result['dynamic'] and 'librocksdb.so' in result['dynamic']
assert result['symbols'] and all('rn_verify_v2' in x for x in result['symbols'])
assert result['artifacts']['tmp/baseline/service']['sha256'] == '369821b9afe85876d6f945ddac4775963ed60b485ca3a26a49ca14ad9d478956'
Path('tmp/optimization-audit.json').write_text(json.dumps(result, indent=2))
print(json.dumps({k:result[k] for k in ('versions','production_lines','tests_lines','artifacts')}, indent=2))
