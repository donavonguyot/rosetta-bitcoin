test "empty transactions, leading zeros, extra fields, and no-witness identifiers" {
    var arena = std.heap.ArenaAllocator.init(testing.allocator);
    defer arena.deinit();
    const allocator = arena.allocator();
    const result = try response(allocator,
        \\{"op":"identify","extra":1,"limits":{},"transaction":{"version_bits":"0001","inputs":[],"outputs":[],"locktime":"00"}}
    );
    try status(result, "ok");
    try testing.expectEqualStrings("01000000000000000000", result.object.get("stripped").?.string);
    try testing.expectEqualStrings(result.object.get("stripped").?.string, result.object.get("full").?.string);
    try testing.expectEqualStrings(result.object.get("txid_digest_order").?.string, result.object.get("wtxid_digest_order").?.string);
}

test "deterministic random transactions round-trip in each applicable mode" {
    var random = std.Random.DefaultPrng.init(0x4a534f4e);
    const rng = random.random();
    for (0..250) |_| {
        var arena = std.heap.ArenaAllocator.init(testing.allocator);
        defer arena.deinit();
        const allocator = arena.allocator();
        const inputs = try allocator.alloc(tx.Input, rng.uintLessThan(usize, 6) + 1);
        const outputs = try allocator.alloc(tx.Output, rng.uintLessThan(usize, 6));
        for (inputs) |*input| {
            rng.bytes(&input.previous_txid_digest_order);
            input.previous_index = rng.int(u32);
            input.sequence = rng.int(u32);
            const script = try allocator.alloc(u8, rng.uintLessThan(usize, 300));
            rng.bytes(script);
            input.script = script;
            const witness = try allocator.alloc([]const u8, rng.uintLessThan(usize, 4));
            for (witness) |*item| {
                const data = try allocator.alloc(u8, rng.uintLessThan(usize, 300));
                rng.bytes(data);
                item.* = data;
            }
            input.witness = witness;
        }
        for (outputs) |*output| {
            output.amount = rng.int(i64);
            const script = try allocator.alloc(u8, rng.uintLessThan(usize, 300));
            rng.bytes(script);
            output.script = script;
        }
        const original = tx.Transaction{ .version_bits = rng.int(u32), .inputs = inputs, .outputs = outputs, .locktime = rng.int(u32) };
        inline for (.{ false, true }) |include_witness| {
            const encoded = try tx.serialize(allocator, original, include_witness, .{});
            const decoded = try tx.decode(allocator, encoded, if (include_witness) .witness else .legacy, .{});
            try testing.expectEqual(encoded.len, decoded.consumed);
            try testing.expectEqualSlices(u8, encoded, try tx.serialize(allocator, decoded.transaction, include_witness, .{}));
            try testing.expectEqual(original.version_bits, decoded.transaction.version_bits);
            try testing.expectEqual(original.locktime, decoded.transaction.locktime);
            for (original.inputs, decoded.transaction.inputs) |a, b| {
                try testing.expectEqualSlices(u8, &a.previous_txid_digest_order, &b.previous_txid_digest_order);
                try testing.expectEqual(a.previous_index, b.previous_index);
                try testing.expectEqual(a.sequence, b.sequence);
                try testing.expectEqualSlices(u8, a.script, b.script);
                if (include_witness) {
                    try testing.expectEqual(a.witness.len, b.witness.len);
                    for (a.witness, b.witness) |wa, wb| try testing.expectEqualSlices(u8, wa, wb);
                } else try testing.expectEqual(@as(usize, 0), b.witness.len);
            }
            for (original.outputs, decoded.transaction.outputs) |a, b| {
                try testing.expectEqual(a.amount, b.amount);
                try testing.expectEqualSlices(u8, a.script, b.script);
            }
        }
    }
}
