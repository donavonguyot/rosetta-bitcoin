func TestSignedAndUnsignedBits(t *testing.T) {
	tx := fixtureTx()
	tx.Version = "4294967295"
	tx.Locktime = "4294967295"
	tx.Inputs[0].Index = "4294967295"
	for _, amount := range []struct{ decimal, wire string }{
		{"-9223372036854775808", "0000000000000080"}, {"9223372036854775807", "ffffffffffffff7f"}, {"-1", "ffffffffffffffff"}, {"0", "0000000000000000"},
	} {
		tx.Outputs[0] = output{Amount: amount.decimal, Script: ""}
		wire := "ffffffff01" + strings.Repeat("00", 32) + "ffffffff00ffffffff01" + amount.wire + "00ffffffff"
		r := invoke(t, map[string]any{"op": "serialize", "transaction": tx, "include_witness": false})
		wantStatus(t, r, "ok")
		if r["bytes"] != wire {
			t.Fatalf("%s: %v", amount.decimal, r)
		}
		r = decode(t, wire, "legacy", true, 4096)
		wantStatus(t, r, "ok")
		if !reflect.DeepEqual(r["transaction"], tx) {
			t.Fatal(r)
		}
	}
}

func TestSizeAndTransportBoundaries(t *testing.T) {
	// Empty inputs and one output use 23 fixed bytes when the script length
	// itself requires the five-byte CompactSize form.
	tx := transaction{Version: "0", Inputs: []input{}, Outputs: []output{{Amount: "0", Script: strings.Repeat("ab", maxWire-23)}}, Locktime: "0"}
	r := invoke(t, map[string]any{"op": "serialize", "transaction": tx, "include_witness": false})
	wantStatus(t, r, "ok")
	if len(r["bytes"].(string))/2 != maxWire {
		t.Fatal("wrong boundary size")
	}
	wantStatus(t, decode(t, r["bytes"].(string), "legacy", true, 1), "ok")
	tx.Outputs[0].Script += "00"
	wantStatus(t, invoke(t, map[string]any{"op": "identify", "transaction": tx}), "resource_limit")
	wantStatus(t, invoke(t, map[string]any{"op": "serialize", "transaction": tx, "include_witness": false}), "resource_limit")
	// Prefix admission counts the complete suffix, not just the consumed tx.
	padded := "00000000000000000000" + strings.Repeat("00", maxWire-10)
	wantStatus(t, decode(t, padded, "legacy", false, 0), "ok")
	wantStatus(t, decode(t, padded+"00", "legacy", false, 0), "admission_limit")
	pool := strings.Repeat("00", maxPool)
	wantStatus(t, invoke(t, map[string]any{"op": "decode_prefix", "mode": "legacy", "bytes": pool, "offset": strconv.Itoa(maxWire)}), "ok")
	wantStatus(t, decode(t, pool, "legacy", false, 0), "admission_limit")
	wantStatus(t, invoke(t, map[string]any{"op": "decode_prefix", "mode": "legacy", "bytes": pool + "00", "offset": strconv.Itoa(maxPool)}), "transport_limit")
	tx.Outputs[0].Script = strings.Repeat("ab", maxPool+1)
	wantStatus(t, invoke(t, map[string]any{"op": "serialize", "transaction": tx, "include_witness": false}), "transport_limit")
	// The pool is aggregate and includes witness bytes even when stripped.
	tx = fixtureTx()
	tx.Inputs[0].Witness = []string{strings.Repeat("00", maxPool-33)}
	wantStatus(t, invoke(t, map[string]any{"op": "serialize", "transaction": tx, "include_witness": false}), "ok")
	tx.Inputs[0].Witness[0] += "00"
	wantStatus(t, invoke(t, map[string]any{"op": "serialize", "transaction": tx, "include_witness": false}), "transport_limit")
}

func TestItemBudget(t *testing.T) {
	tx := transaction{Version: "0", Inputs: []input{}, Outputs: make([]output, 4097), Locktime: "0"}
	for i := range tx.Outputs {
		tx.Outputs[i] = output{Amount: "0", Script: ""}
	}
	wantStatus(t, invoke(t, map[string]any{"op": "identify", "transaction": tx}), "resource_limit")
	tx.Outputs = tx.Outputs[:4096]
	r := invoke(t, map[string]any{"op": "serialize", "transaction": tx, "include_witness": false})
	wantStatus(t, r, "ok")
	wantStatus(t, decode(t, r["bytes"].(string), "legacy", true, 4096), "ok")
	wantStatus(t, decode(t, r["bytes"].(string), "legacy", true, 4095), "resource_limit")
	wire := "0000000000fd0110" + strings.Repeat("00", 4097*9) + "00000000"
	wantStatus(t, decode(t, wire, "legacy", true, 4096), "resource_limit")
	wantStatus(t, decode(t, wire[:len(wire)-2], "legacy", true, 4096), "malformed_encoding")
	tx = fixtureTx()
	tx.Inputs[0].Witness = []string{""}
	wantStatus(t, invoke(t, map[string]any{"op": "serialize", "transaction": tx, "include_witness": false, "limits": map[string]string{"max_items": "2"}}), "resource_limit")
}

func TestJSONLines(t *testing.T) {
	valid := `{"op":"decode_exact","bytes":"00000000000000000000","mode":"legacy"}`
	tests := []struct {
		name, text string
		statuses   []string
	}{
		{"empty", "", nil},
		{"blank", "\n", []string{"invalid_request"}},
		{"mixed", valid + "\r\n" + "{}\n" + valid, []string{"ok", "invalid_request", "ok"}},
		{"max_text", valid + strings.Repeat(" ", maxText-len(valid)) + "\n", []string{"ok"}},
		{"oversize_recovery", strings.Repeat(" ", maxText+1) + "\n" + valid + "\n", []string{"transport_limit", "ok"}},
		{"oversize_eof", strings.Repeat(" ", maxText+1), []string{"transport_limit"}},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			var out bytes.Buffer
			if err := serve(strings.NewReader(tt.text), &out); err != nil {
				t.Fatal(err)
			}
			var statuses []string
			for _, line := range bytes.Split(bytes.TrimSuffix(out.Bytes(), []byte{'\n'}), []byte{'\n'}) {
				if len(line) == 0 {
					continue
				}
				var r response
				if err := json.Unmarshal(line, &r); err != nil {
					t.Fatal(err)
				}
				statuses = append(statuses, r["status"].(string))
				if r["status"] != "ok" && len(r) != 1 {
					t.Fatal(r)
				}
			}
			if !reflect.DeepEqual(statuses, tt.statuses) {
				t.Fatalf("got %v, want %v", statuses, tt.statuses)
			}
		})
	}
}

func TestScriptLengthBoundaries(t *testing.T) {
	for _, n := range []int{0, 1, 252, 253, 254, 65535, 65536} {
		t.Run(strconv.Itoa(n), func(t *testing.T) {
			tx := fixtureTx()
			tx.Inputs[0].Script = strings.Repeat("ab", n)
			tx.Outputs[0].Script = strings.Repeat("cd", n)
			tx.Inputs[0].Witness = []string{strings.Repeat("ef", n)}
			r := invoke(t, map[string]any{"op": "identify", "transaction": tx})
			wantStatus(t, r, "ok")
			full := r["full"].(string)
			decoded := decode(t, full, "witness", true, 3)
			wantStatus(t, decoded, "ok")
			if !reflect.DeepEqual(decoded["transaction"], tx) {
				t.Fatal("round trip changed transaction")
			}
			// All proper prefixes of the witness encoding must be incomplete.
			if n <= 254 {
				for i := 0; i < len(full); i += 2 {
					wantStatus(t, decode(t, full[:i], "witness", false, 0), "malformed_encoding")
				}
			}
		})
	}
}

func TestDeterministicRoundTrips(t *testing.T) {
	rng := rand.New(rand.NewSource(1081))
	randomHex := func(n int) string { b := make([]byte, n); _, _ = rng.Read(b); return hex.EncodeToString(b) }
	for k := 0; k < 250; k++ {
		tx := transaction{Version: strconv.FormatUint(uint64(rng.Uint32()), 10), Inputs: []input{}, Outputs: []output{}, Locktime: strconv.FormatUint(uint64(rng.Uint32()), 10)}
		for i := rng.Intn(4) + 1; i > 0; i-- {
			in := input{Previous: randomHex(32), Index: strconv.FormatUint(uint64(rng.Uint32()), 10), Script: randomHex(rng.Intn(32)), Sequence: strconv.FormatUint(uint64(rng.Uint32()), 10), Witness: []string{}}
			for j := rng.Intn(4); j > 0; j-- {
				in.Witness = append(in.Witness, randomHex(rng.Intn(32)))
			}
			tx.Inputs = append(tx.Inputs, in)
		}
		for i := rng.Intn(4); i > 0; i-- {
			tx.Outputs = append(tx.Outputs, output{Amount: strconv.FormatInt(int64(rng.Uint64()), 10), Script: randomHex(rng.Intn(32))})
		}
		r := invoke(t, map[string]any{"op": "identify", "transaction": tx})
		wantStatus(t, r, "ok")
		for _, item := range []struct {
			field, mode string
			witness     bool
		}{{"full", "witness", true}, {"stripped", "legacy", false}} {
			wire := r[item.field].(string)
			d := decode(t, wire, item.mode, true, 4096)
			wantStatus(t, d, "ok")
			s := invoke(t, map[string]any{"op": "serialize", "transaction": d["transaction"], "include_witness": item.witness})
			wantStatus(t, s, "ok")
			if s["bytes"] != wire || d["consumed"] != strconv.Itoa(len(wire)/2) {
				t.Fatalf("case %d %s did not round trip", k, item.field)
			}
		}
		if !hasWitness(&tx) && r["full"] != r["stripped"] {
			t.Fatal("empty witness changed encoding")
		}
		if hasWitness(&tx) && r["txid_digest_order"] == r["wtxid_digest_order"] {
			t.Fatal("witness did not affect full identifier")
		}
	}
}

func FuzzStructuralScan(f *testing.F) {
	for _, s := range []string{fixtureWire, "00000000000000000000", "00000000000101" + strings.Repeat("00", 41) + "00010000000000", "00000000ffffffffffffffffff"} {
		b, _ := hex.DecodeString(s)
		f.Add(b, true)
		f.Add(b, false)
	}
	f.Fuzz(func(t *testing.T, b []byte, witness bool) {
		if len(b) > maxWire {
			t.Skip()
		}
		c := cursor{data: b}
		if !c.transaction(witness, nil) {
			return
		}
		if c.pos < 10 || c.pos > len(b) {
			t.Fatal("invalid cursor")
		}
		if c.items > maxItems {
			return
		}
		material := cursor{data: b}
		var tx transaction
		if !material.transaction(witness, &tx) || material.pos != c.pos || material.items != c.items {
			t.Fatal("scan/materialize disagreement")
		}
		result := invoke(t, map[string]any{"op": "identify", "transaction": tx})
		wantStatus(t, result, "ok")
	})
}

func Example_handle() {
	r := handle([]byte(`{"op":"serialize","transaction":{"version_bits":"1","inputs":[],"outputs":[],"locktime":"0"},"include_witness":false}`))
	fmt.Println(r["status"], r["bytes"])
	// Output: ok 01000000000000000000
}
