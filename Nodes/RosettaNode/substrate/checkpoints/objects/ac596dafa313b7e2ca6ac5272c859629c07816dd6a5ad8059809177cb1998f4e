		`null`, `[]`, `{}`, `{"op":"wat"}`, `{"op":"decode_exact","bytes":"","mode":"bad"}`,
		`{"op":"decode_exact","bytes":"0","mode":"legacy"}`, `{"op":"decode_exact","bytes":"gg","mode":"legacy"}`,
		`{"op":"decode_exact","bytes":null,"mode":"legacy"}`, `{"op":"decode_exact","bytes":""}`,
		`{"op":"decode_exact","bytes":"","mode":"legacy","limits":null}`,
		`{"op":"decode_exact","bytes":"","mode":"legacy","limits":{"max_items":"4097"}}`,
		`{"op":"decode_exact","bytes":"","mode":"legacy","limits":{"max_items":0}}`,
		`{"op":"serialize","include_witness":false,"transaction":null}`, `{} {}`, `{`,
	} {
		wantStatus(t, handle([]byte(raw)), "invalid_request")
	}
	mutations := []struct {
		name   string
		mutate func(map[string]any)
	}{
		{"extra_tx", func(m map[string]any) { m["extra"] = 0 }},
		{"missing_locktime", func(m map[string]any) { delete(m, "locktime") }},
		{"negative_version", func(m map[string]any) { m["version_bits"] = "-1" }},
		{"large_version", func(m map[string]any) { m["version_bits"] = "4294967296" }},
		{"number_version", func(m map[string]any) { m["version_bits"] = 1 }},
		{"leading_zero", func(m map[string]any) { m["version_bits"] = "01" }},
		{"plus", func(m map[string]any) { m["version_bits"] = "+1" }},
		{"null_inputs", func(m map[string]any) { m["inputs"] = nil }},
		{"object_outputs", func(m map[string]any) { m["outputs"] = map[string]any{} }},
		{"extra_input", func(m map[string]any) { m["inputs"].([]any)[0].(map[string]any)["extra"] = 1 }},
		{"bad_digest", func(m map[string]any) { m["inputs"].([]any)[0].(map[string]any)["previous_txid_digest_order"] = "00" }},
		{"bad_index", func(m map[string]any) { m["inputs"].([]any)[0].(map[string]any)["previous_index"] = "-1" }},
		{"bad_sequence", func(m map[string]any) { m["inputs"].([]any)[0].(map[string]any)["sequence"] = "4294967296" }},
		{"null_script", func(m map[string]any) { m["inputs"].([]any)[0].(map[string]any)["script"] = nil }},
		{"invalid_hex", func(m map[string]any) { m["inputs"].([]any)[0].(map[string]any)["script"] = "xy" }},
		{"null_witness", func(m map[string]any) { m["inputs"].([]any)[0].(map[string]any)["witness"] = nil }},
		{"bad_item", func(m map[string]any) { m["inputs"].([]any)[0].(map[string]any)["witness"] = []any{0} }},
		{"extra_output", func(m map[string]any) { m["outputs"].([]any)[0].(map[string]any)["extra"] = 1 }},
		{"negative_zero", func(m map[string]any) { m["outputs"].([]any)[0].(map[string]any)["amount"] = "-0" }},
		{"large_amount", func(m map[string]any) { m["outputs"].([]any)[0].(map[string]any)["amount"] = "9223372036854775808" }},
		{"small_amount", func(m map[string]any) { m["outputs"].([]any)[0].(map[string]any)["amount"] = "-9223372036854775809" }},
