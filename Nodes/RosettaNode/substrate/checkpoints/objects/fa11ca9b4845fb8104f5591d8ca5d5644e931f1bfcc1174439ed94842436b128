use super::*;
use codec::{Input, Output, hex, unhex};

fn tx() -> Transaction {
    Transaction {
        version_bits: 2,
        inputs: vec![Input {
            previous_txid: [0x11; 32], previous_index: 1, script: vec![], sequence: 0xfffffffe,
            witness: vec![vec![], vec![0xaa, 0xbb, 0xcc]],
        }],
        outputs: vec![Output { amount: 5000, script: vec![0x51] }],
        locktime: 42,
    }
}
fn empty_tx() -> Transaction {
    Transaction { version_bits: 1, inputs: vec![], outputs: vec![], locktime: 0 }
}
fn decode_request(bytes: &[u8], mode: &str) -> Json {
    object(vec![("op", string("decode_exact")), ("bytes", string(hex(bytes))), ("mode", string(mode))])
}
fn serialization_request(tx: &Transaction, witness: bool) -> Json {
    object(vec![("op", string("serialize")), ("transaction", tx.to_json()), ("include_witness", Json::Bool(witness))])
}
fn identification_request(tx: &Transaction) -> Json { object(vec![("op", string("identify")), ("transaction", tx.to_json())]) }
fn get_text<'a>(v: &'a Json, name: &str) -> &'a str { v.get(name).unwrap().string().unwrap() }
fn run_line(s: &str) -> Json { process_line(s.as_bytes()) }

