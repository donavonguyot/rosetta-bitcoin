#[test]
fn genesis_decode_serialize_and_identify() {
    let bytes = genesis_bytes();
    assert_eq!(bytes.len(), 204);
    for mode in ["legacy", "witness"] {
        let decoded = handle(&decode_request(&bytes, mode)).unwrap();
        assert_eq!(get_text(&decoded, "consumed"), "204");
        let tx = Transaction::from_json(decoded.get("transaction").unwrap()).unwrap();
        assert_eq!(tx.version_bits, 1);
        assert_eq!(tx.inputs.len(), 1);
        assert_eq!(tx.inputs[0].previous_txid, [0; 32]);
        assert_eq!(tx.inputs[0].previous_index, u32::MAX);
        assert_eq!(tx.inputs[0].script.len(), 77);
        assert_eq!(&tx.inputs[0].script[8..], b"The Times 03/Jan/2009 Chancellor on brink of second bailout for banks");
        assert_eq!(tx.outputs[0].amount, 5_000_000_000);
        assert_eq!(tx.outputs[0].script.len(), 67);
        for include in [false, true] {
            let serialized = handle(&serialization_request(&tx, include)).unwrap();
            assert_eq!(get_text(&serialized, "bytes"), hex(&bytes));
        }
        let id = handle(&identification_request(&tx)).unwrap();
        assert_eq!(get_text(&id, "txid_display_order"), "4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b");
        assert_eq!(get_text(&id, "txid_digest_order"), "3ba3edfd7a7b12b27ac72c3e67768f617fc81bc3888a51323a9fb8aa4b1e5e4a");
        assert_eq!(id.get("txid_digest_order"), id.get("wtxid_digest_order"));
        assert_eq!(id.get("stripped"), id.get("full"));
    }
}

#[test]
fn witness_and_stripped_literal_encodings() {
    let transaction = tx();
    let full = concat!(
        "02000000000101", "1111111111111111111111111111111111111111111111111111111111111111",
        "0100000000feffffff0188130000000000000151020003aabbcc2a000000"
    );
    let stripped = concat!(
        "0200000001", "1111111111111111111111111111111111111111111111111111111111111111",
        "0100000000feffffff01881300000000000001512a000000"
    );
    assert_eq!(hex(&codec::serialize(&transaction, true, Limits::default()).unwrap()), full);
    assert_eq!(hex(&codec::serialize(&transaction, false, Limits::default()).unwrap()), stripped);
    let decoded = codec::decode(&unhex(full).unwrap(), 0, true, Limits::default()).unwrap();
    assert_eq!(decoded, (transaction.clone(), 69));
    let mut bare = transaction.clone();
    bare.inputs[0].witness.clear();
    assert_eq!(codec::decode(&unhex(stripped).unwrap(), 0, false, Limits::default()).unwrap(), (bare.clone(), 61));
    assert_eq!(codec::decode(&unhex(stripped).unwrap(), 0, true, Limits::default()).unwrap(), (bare, 61));
    let id = handle(&identification_request(&transaction)).unwrap();
    assert_eq!(get_text(&id, "full"), full);
    assert_eq!(get_text(&id, "stripped"), stripped);
    assert_eq!(get_text(&id, "full_size"), "69");
    assert_eq!(get_text(&id, "stripped_size"), "61");
    assert_ne!(id.get("txid_digest_order"), id.get("wtxid_digest_order"));
    for (digest, display) in [("txid_digest_order", "txid_display_order"), ("wtxid_digest_order", "wtxid_display_order")] {
        let mut expected = unhex(get_text(&id, digest)).unwrap();
        expected.reverse();
        assert_eq!(hex(&expected), get_text(&id, display));
    }
}

#[test]
fn prefix_offsets_and_exact_trailing_bytes() {
    let original = codec::serialize(&tx(), true, Limits::default()).unwrap();
    let mut bytes = vec![0xee, 0xff, 0x12];
    bytes.extend_from_slice(&original);
    bytes.extend_from_slice(&[0xaa, 0xbb]);
    let request = object(vec![
        ("op", string("decode_prefix")), ("bytes", string(hex(&bytes))),
        ("offset", string("3")), ("mode", string("witness")),
    ]);
    let response = handle(&request).unwrap();
    assert_eq!(get_text(&response, "consumed"), "69");
    assert_eq!(response.get("transaction"), Some(&tx().to_json()));
    assert_eq!(handle(&decode_request(&bytes[3..], "witness")), Err(Error::MalformedEncoding));
    assert_eq!(codec::decode(&bytes, bytes.len()+1, true, Limits::default()), Err(Error::InvalidRequest));
    assert_eq!(codec::decode(&bytes, bytes.len(), true, Limits::default()), Err(Error::MalformedEncoding));
}

