#[test]
fn empty_transaction_and_no_consensus_checks() {
    let bytes = unhex("01000000000000000000").unwrap();
    assert_eq!(codec::serialize(&empty_tx(), true, Limits::default()).unwrap(), bytes);
    assert_eq!(codec::serialize(&empty_tx(), false, Limits::default()).unwrap(), bytes);
    for mode in [false, true] {
        assert_eq!(codec::decode(&bytes, 0, mode, Limits { max_items: 0 }).unwrap(), (empty_tx(), 10));
    }
    let mut unusual = tx();
    unusual.version_bits = u32::MAX;
    unusual.inputs[0].previous_index = u32::MAX;
    unusual.inputs[0].sequence = u32::MAX;
    unusual.outputs[0].amount = u64::MAX;
    unusual.locktime = u32::MAX;
    let encoded = codec::serialize(&unusual, true, Limits::default()).unwrap();
    assert_eq!(&encoded[..4], &[255; 4]);
    assert_eq!(codec::decode(&encoded, 0, true, Limits::default()).unwrap().0, unusual);
    let encoded_json = unusual.to_json().encode();
    assert_eq!(Transaction::from_json(&json::parse(&encoded_json).unwrap()).unwrap(), unusual);
    let mut no_inputs = empty_tx();
    no_inputs.outputs.push(Output { amount: u64::MAX, script: vec![0xff] });
    let bytes = codec::serialize(&no_inputs, false, Limits::default()).unwrap();
    assert_eq!(codec::decode(&bytes, 0, false, Limits::default()).unwrap().0, no_inputs);
}

#[test]
fn witness_flags_empty_stacks_and_empty_items() {
    let mut transaction = tx();
    transaction.inputs[0].witness = vec![vec![]];
    let valid = codec::serialize(&transaction, true, Limits::default()).unwrap();
    assert_eq!(codec::decode(&valid, 0, true, Limits::default()).unwrap().0, transaction);
    let mut superfluous = valid.clone();
    let witness_start = superfluous.len() - 6;
    superfluous[witness_start] = 0;
    superfluous.remove(witness_start+1);
    assert_eq!(codec::decode(&superfluous, 0, true, Limits::default()), Err(Error::MalformedEncoding));
    for flag in [2, 3, 0x80, 0xff] {
        let mut bad = valid.clone();
        bad[5] = flag;
        assert_eq!(codec::decode(&bad, 0, true, Limits::default()), Err(Error::MalformedEncoding));
    }
    transaction.inputs[0].witness.clear();
    let no_witness = codec::serialize(&transaction, true, Limits::default()).unwrap();
    assert_eq!(no_witness[4], 1);
    let mut other = transaction.inputs[0].clone();
    other.witness = vec![vec![0x42]];
    transaction.inputs.push(other);
    let mixed = codec::serialize(&transaction, true, Limits::default()).unwrap();
    assert_eq!(codec::decode(&mixed, 0, true, Limits::default()).unwrap().0, transaction);
}

#[test]
fn script_length_compactsize_thresholds() {
    for n in [0, 1, 252, 253, 254, 65535, 65536] {
        let mut transaction = tx();
        transaction.inputs[0].script = vec![0x42; n];
        transaction.outputs[0].script = vec![0x51; n];
        transaction.inputs[0].witness = vec![vec![0x99; n]];
        let encoded = codec::serialize(&transaction, true, Limits::default()).unwrap();
        assert_eq!(codec::decode(&encoded, 0, true, Limits::default()).unwrap().0, transaction);
        let header = &encoded[43..];
        let expected = match n {
            0..=252 => vec![n as u8],
            253..=65535 => vec![253, n as u8, (n >> 8) as u8],
            _ => vec![254, 0, 0, 1, 0],
        };
        assert!(header.starts_with(&expected));
    }
}

#[test]
fn compactsize_vector_count_thresholds() {
    for n in [252, 253] {
        let mut transaction = tx();
        transaction.inputs = vec![transaction.inputs[0].clone(); n];
        transaction.outputs = vec![transaction.outputs[0].clone(); n];
        transaction.inputs[0].witness = vec![vec![]; n];
        let bytes = codec::serialize(&transaction, true, Limits::default()).unwrap();
        assert_eq!(codec::decode(&bytes, 0, true, Limits::default()).unwrap().0, transaction);
    }
}

#[test]
fn limits_apply_to_each_encoded_vector() {
    let transaction = tx();
    let bytes = codec::serialize(&transaction, true, Limits::default()).unwrap();
    let three = Limits { max_items: 3 };
    assert!(codec::serialize(&transaction, true, three).is_ok());
    assert!(codec::decode(&bytes, 0, true, three).is_ok());
    for max_items in [0, 1, 2] {
        assert_eq!(codec::serialize(&transaction, true, Limits { max_items }), Err(Error::ResourceLimit));
        assert_eq!(codec::decode(&bytes, 0, true, Limits { max_items }), Err(Error::ResourceLimit));
    }
    // Witness limits do not affect an encoding that omits witness data.
    assert!(codec::serialize(&transaction, false, Limits { max_items: 1 }).is_ok());
    let mut large_script = empty_tx();
    large_script.outputs.push(Output { amount: 0, script: vec![0; 4] });
    assert_eq!(codec::serialize(&large_script, false, three), Err(Error::ResourceLimit));
    let bytes = codec::serialize(&large_script, false, Limits::default()).unwrap();
    assert_eq!(codec::decode(&bytes, 0, false, three), Err(Error::ResourceLimit));
    let truncated_huge = unhex("01000000ffffffffffffffffff").unwrap();
    assert_eq!(codec::decode(&truncated_huge, 0, false, Limits { max_items: 100 }), Err(Error::ResourceLimit));
    assert_eq!(codec::decode(&truncated_huge, 0, false, Limits::default()), Err(Error::MalformedEncoding));
}

#[test]
fn noncanonical_lengths_at_transaction_fields() {
    let mut bare = tx();
    bare.inputs[0].witness.clear();
    let bytes = codec::serialize(&bare, false, Limits::default()).unwrap();
    // Input count, input script length, output count, output script length.
    for index in [4, 41, 46, 55] {
        let mut altered = bytes.clone();
        let n = altered[index];
        altered.splice(index..index+1, [253, n, 0]);
        assert_eq!(codec::decode(&altered, 0, false, Limits::default()), Err(Error::MalformedEncoding));
    }
    let full = codec::serialize(&tx(), true, Limits::default()).unwrap();
    for index in [59, 60, 61] {
        let mut altered = full.clone();
        let n = altered[index];
        altered.splice(index..index+1, [253, n, 0]);
        assert_eq!(codec::decode(&altered, 0, true, Limits::default()), Err(Error::MalformedEncoding));
    }
}

#[test]
fn json_strings_numbers_and_errors() {
    let parsed = json::parse(r#"{"x":"\"\\\/\b\f\n\r\t\u0000\u00e9\ud83d\ude00","n":-1.2e+3,"a":[true,false,null]}"#).unwrap();
    assert_eq!(get_text(&parsed, "x"), "\"\\/\u{08}\u{0c}\n\r\t\0é😀");
    assert_eq!(json::parse(&parsed.encode()).unwrap(), parsed);
    for s in ["", " ", "[", "{", "[1,]", "{\"a\":1,}", "01", "-", "1.", "1e", "NaN", "true false", "\"\n\"", r#""\ud800""#, r#""\udc00""#, r#""\ud800\u0061""#, r#""\q""#] {
        assert!(json::parse(s).is_err(), "{s:?}");
    }
    let deep = format!("{}0{}", "[".repeat(258), "]".repeat(258));
    assert_eq!(json::parse(&deep), Err(json::ParseError::Depth));
    assert_eq!(get_text(&run_line(&deep), "status"), "admission_limit");
    assert_eq!(process_line(&[0xff]), Error::InvalidRequest.response());
}

#[test]
fn invalid_request_shapes_and_ranges() {
    for request in [
        "null", "true", "[]", "{}", r#"{"op":"wat"}"#,
        r#"{"op":"decode_exact","bytes":"","mode":"bad"}"#,
        r#"{"op":"decode_exact","bytes":"0","mode":"legacy"}"#,
        r#"{"op":"decode_exact","bytes":"gg","mode":"legacy"}"#,
        r#"{"op":"decode_exact","bytes":"","mode":"legacy","limits":{"max_items":2}}"#,
        r#"{"op":"decode_exact","bytes":"","mode":"legacy","limits":false}"#,
        r#"{"op":"decode_prefix","bytes":"","mode":"legacy"}"#,
        r#"{"op":"decode_prefix","bytes":"","mode":"legacy","offset":"-1"}"#,
        r#"{"op":"decode_prefix","bytes":"","mode":"legacy","offset":"1"}"#,
        r#"{"op":"decode_prefix","bytes":"","mode":"legacy","offset":0}"#,
    ] {
        assert_eq!(run_line(request), Error::InvalidRequest.response(), "{request}");
    }
    for n in ["", "-1", "+1", " 1", "1.0", "18446744073709551616", "١"] { assert_eq!(uint(&string(n)), Err(Error::InvalidRequest)); }
    assert_eq!(uint(&string("000123")), Ok(123));
    let mut transaction = tx().to_json();
    if let Json::Object(fields) = &mut transaction { fields.push(("version_bits".into(), string("4294967296"))); }
    assert_eq!(Transaction::from_json(&transaction), Err(Error::InvalidRequest));
    let mut transaction = tx().to_json();
    if let Json::Object(fields) = &mut transaction {
        if let Json::Array(inputs) = &mut fields.iter_mut().find(|(k,_)| k == "inputs").unwrap().1 {
            if let Json::Object(fields) = &mut inputs[0] { fields.push(("previous_txid_digest_order".into(), string("00"))); }
        }
    }
    assert_eq!(Transaction::from_json(&transaction), Err(Error::InvalidRequest));
}

#[test]
fn uppercase_hex_decimal_normalization_and_extra_fields() {
    let original = serialization_request(&empty_tx(), false).encode();
    let request = original.replace("\"1\"", "\"0001\"").replace("\"include_witness\":false", "\"include_witness\":false,\"extra\":123");
    assert_eq!(get_text(&run_line(&request), "bytes"), "01000000000000000000");
    let mut transaction = tx();
    transaction.inputs[0].script = vec![0xab, 0xcd];
    let mut request = serialization_request(&transaction, true).encode();
    request = request.replace("abcd", "ABCD").replace("aabbcc", "AABBCC");
    assert_eq!(run_line(&request), handle(&serialization_request(&transaction, true)).unwrap());
}

struct Random(u64);
impl Random {
    fn next(&mut self) -> u64 { self.0 ^= self.0 << 13; self.0 ^= self.0 >> 7; self.0 ^= self.0 << 17; self.0 }
    fn count(&mut self, max: usize) -> usize { self.next() as usize % max }
    fn blob(&mut self, max: usize) -> Vec<u8> { let n = self.count(max); (0..n).map(|_| self.next() as u8).collect() }
}

#[test]
fn generated_transactions_roundtrip_and_stripping() {
    let mut random = Random(0x1020304050607080);
    for _ in 0..1000 {
        let mut transaction = Transaction { version_bits: random.next() as u32, inputs: vec![], outputs: vec![], locktime: random.next() as u32 };
        for _ in 0..1+random.count(4) {
            let mut digest = [0;32];
            for byte in &mut digest { *byte = random.next() as u8; }
            let mut witness = Vec::new();
            for _ in 0..random.count(4) { witness.push(random.blob(40)); }
            transaction.inputs.push(Input {
                previous_txid: digest, previous_index: random.next() as u32,
                script: random.blob(60), sequence: random.next() as u32, witness,
            });
        }
        for _ in 0..random.count(5) { transaction.outputs.push(Output { amount: random.next(), script: random.blob(60) }); }
        for witness in [false, true] {
            let bytes = codec::serialize(&transaction, witness, Limits::default()).unwrap();
            let mut expected = transaction.clone();
            if !witness { for input in &mut expected.inputs { input.witness.clear(); } }
            assert_eq!(codec::decode(&bytes, 0, witness, Limits::default()).unwrap(), (expected, bytes.len()));
        }
        assert_eq!(Transaction::from_json(&json::parse(&transaction.to_json().encode()).unwrap()).unwrap(), transaction);
    }
}

#[test]
fn malformed_input_smoke_fuzz() {
    let mut random = Random(0xabcdef7654321);
    for _ in 0..20_000 {
        let bytes = random.blob(250);
        for mode in [false, true] { let _ = codec::decode(&bytes, 0, mode, Limits { max_items: 1000 }); }
        let _ = process_line(&bytes);
    }
    let bases = [genesis_bytes(), codec::serialize(&tx(), true, Limits::default()).unwrap()];
    for _ in 0..10_000 {
        let mut mutated = bases[random.count(2)].clone();
        let index = random.count(mutated.len());
        mutated[index] = random.next() as u8;
        for mode in [false, true] {
            if let Ok((decoded, consumed)) = codec::decode(&mutated, 0, mode, Limits { max_items: 1000 }) {
                let bytes = codec::serialize(&decoded, mode, Limits { max_items: 1000 }).unwrap();
                assert_eq!(&bytes, &mutated[..consumed]);
            }
        }
    }
}
