func TestLargeScriptsAndCounts(t *testing.T) {
	for _, n := range []int{252, 253, 65535, 65536} {
		t.Run(strconv.Itoa(n), func(t *testing.T) {
			tx := fixture()
			tx.Inputs[0].Script = strings.Repeat("ab", n)
			tx.Outputs[0].Script = strings.Repeat("cd", n)
			tx.Inputs[0].Witness = []string{strings.Repeat("ef", n)}
			result := request(t, map[string]any{"op": "serialize", "transaction": tx, "include_witness": true})
			expectStatus(t, result, "ok")
			decoded := request(t, map[string]any{"op": "decode_exact", "bytes": result["bytes"], "mode": "witness"})
			expectStatus(t, decoded, "ok")
			if !reflect.DeepEqual(decoded["transaction"], tx) {
				t.Fatal("large script round trip failed")
			}
		})
	}
	tx := fixture()
	input := tx.Inputs[0]
	tx.Inputs = make([]inputJSON, 253)
	for i := range tx.Inputs {
		tx.Inputs[i] = input
	}
	tx.Outputs = make([]outputJSON, 253)
	for i := range tx.Outputs {
		tx.Outputs[i] = outputJSON{Amount: "0", Script: ""}
	}
	tx.Inputs[0].Witness = make([]string, 253)
	result := request(t, map[string]any{"op": "serialize", "transaction": tx, "include_witness": true})
	expectStatus(t, result, "ok")
	decoded := request(t, map[string]any{"op": "decode_exact", "bytes": result["bytes"], "mode": "witness"})
	expectStatus(t, decoded, "ok")
	if !reflect.DeepEqual(decoded["transaction"], tx) {
		t.Fatal("large collection round trip failed")
	}
}

func TestRandomRoundTrips(t *testing.T) {
	rng := rand.New(rand.NewSource(1987))
	randomBytes := func(n int) []byte {
		b := make([]byte, n)
		_, _ = rng.Read(b)
		return b
	}
	for trial := 0; trial < 300; trial++ {
		tx := &transaction{
			version: rng.Uint32(), locktime: rng.Uint32(),
			inputs: make([]txInput, 1+rng.Intn(5)), outputs: make([]txOutput, rng.Intn(6)),
		}
		for i := range tx.inputs {
			input := &tx.inputs[i]
			copy(input.previous[:], randomBytes(32))
			input.index, input.sequence = rng.Uint32(), rng.Uint32()
			input.script = randomBytes(rng.Intn(300))
			input.witness = make([][]byte, rng.Intn(4))
			for j := range input.witness {
				input.witness[j] = randomBytes(rng.Intn(300))
			}
		}
		for i := range tx.outputs {
			tx.outputs[i] = txOutput{amount: int64(rng.Uint64()), script: randomBytes(rng.Intn(300))}
		}
		for _, withWitness := range []bool{false, true} {
			b, err := serialize(tx, withWitness)
			if err != nil {
				t.Fatal(err)
			}
			decoded, consumed, err := decode(b, withWitness, unlimited)
			if err != nil || consumed != len(b) {
				t.Fatalf("trial %d witness %v: %d, %v", trial, withWitness, consumed, err)
			}
			want := tx.jsonValue()
			if !withWitness {
				for i := range want.Inputs {
					want.Inputs[i].Witness = []string{}
				}
			}
			if !reflect.DeepEqual(decoded.jsonValue(), want) {
				t.Fatalf("trial %d: fields changed", trial)
			}
			b2, err := serialize(decoded, withWitness)
			if err != nil || !bytes.Equal(b, b2) {
				t.Fatalf("trial %d: bytes changed", trial)
			}
		}
	}
}

func TestJSONLines(t *testing.T) {
	tx := fixture()
	tx.Inputs[0].Script = strings.Repeat("00", 65536)
	large, err := json.Marshal(map[string]any{"op": "identify", "transaction": tx})
	if err != nil {
		t.Fatal(err)
	}
	input := "{broken}\n\n" + string(large) + "\r\n" +
		`{"op":"serialize","transaction":{"version_bits":"1","inputs":[],"outputs":[],"locktime":"0"},"include_witness":false}`
	var output bytes.Buffer
	if err := run(strings.NewReader(input), &output); err != nil {
		t.Fatal(err)
	}
	lines := strings.Split(strings.TrimSuffix(output.String(), "\n"), "\n")
	if len(lines) != 4 {
		t.Fatalf("got %d lines", len(lines))
	}
	for i, line := range lines {
		var result response
		if err := json.Unmarshal([]byte(line), &result); err != nil {
			t.Fatal(err)
		}
		want := "ok"
		if i < 2 {
			want = "invalid_request"
		}
		expectStatus(t, result, want)
	}
}

// Seeded fuzzing also supplies a useful regression corpus during ordinary
// go test runs. A successful decode must be bounded and canonically stable.
func FuzzDecode(f *testing.F) {
	for _, h := range []string{"", "01000000000000000000", fixtureStripped, fixtureFull, "01000000ffffffffffffffffff"} {
		b, _ := hex.DecodeString(h)
		f.Add(b, true)
		f.Add(b, false)
	}
	f.Fuzz(func(t *testing.T, data []byte, witness bool) {
		tx, consumed, err := decode(data, witness, 10000)
		if err != nil {
			if !errors.Is(err, errMalformed) && !errors.Is(err, errLimit) {
				t.Fatal(err)
			}
			return
		}
		if consumed < 10 || consumed > len(data) {
			t.Fatalf("invalid consumption: %d/%d", consumed, len(data))
		}
		encoded, err := serialize(tx, witness)
		if err != nil || !bytes.Equal(encoded, data[:consumed]) {
			t.Fatalf("successful decode did not reserialize exactly: %v", err)
		}
	})
}

func FuzzRequests(f *testing.F) {
	for _, raw := range []string{
		`{"op":"identify","transaction":{"version_bits":"1","inputs":[],"outputs":[],"locktime":"0"}}`,
		`{"op":"decode_exact","bytes":"01000000000000000000","mode":"witness"}`,
		`{"op":"serialize","transaction":null,"include_witness":true}`, "null", "{}",
	} {
		f.Add(raw)
	}
	f.Fuzz(func(t *testing.T, raw string) {
		result := handleLine([]byte(raw))
		status, ok := result["status"].(string)
		if !ok || status == "execution_failure" {
			t.Fatalf("unexpected internal error: %v", result)
		}
		if status != "ok" && len(result) != 1 {
			t.Fatal(result)
		}
		if _, err := json.Marshal(result); err != nil {
			t.Fatal(err)
		}
	})
}
