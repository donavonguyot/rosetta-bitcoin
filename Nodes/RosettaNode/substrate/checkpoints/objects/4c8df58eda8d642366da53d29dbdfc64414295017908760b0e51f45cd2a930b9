const unlimited = ^uint64(0)

// These layouts are constructed directly from the field widths and byte
// order, independently of the serializer under test.
const fixtureDigest = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
const fixtureBody = "01" + fixtureDigest + "785634120300abfffeffffff" +
	"0208070605040302010151ffffffffffffffff00"
const fixtureStripped = "02000080" + fixtureBody + "04030201"
const fixtureFull = "020000800001" + fixtureBody + "030002aabb0100" + "04030201"

func fixture() transactionJSON {
	return transactionJSON{
		VersionBits: "2147483650",
		Inputs: []inputJSON{{
			PreviousTxidDigestOrder: fixtureDigest, PreviousIndex: "305419896",
			Script: "00abff", Sequence: "4294967294", Witness: []string{"", "aabb", "00"},
		}},
		Outputs:  []outputJSON{{Amount: "72623859790382856", Script: "51"}, {Amount: "-1", Script: ""}},
		Locktime: "16909060",
	}
}

func emptyFixture() transactionJSON {
	return transactionJSON{VersionBits: "1", Inputs: []inputJSON{}, Outputs: []outputJSON{}, Locktime: "0"}
}

func request(t *testing.T, value any) response {
	t.Helper()
	raw, err := json.Marshal(value)
	if err != nil {
		t.Fatal(err)
	}
	return handleLine(raw)
}

func expectStatus(t *testing.T, result response, status string) {
	t.Helper()
	if result["status"] != status {
		t.Fatalf("status: got %v, want %s; response: %v", result["status"], status, result)
	}
	if status != "ok" && len(result) != 1 {
		t.Fatalf("error response has extra fields: %v", result)
	}
}

func fromHex(t *testing.T, s string) []byte {
	t.Helper()
	b, err := hex.DecodeString(s)
	if err != nil {
		t.Fatal(err)
	}
	return b
}

func TestFixedEncodings(t *testing.T) {
	for _, withWitness := range []bool{false, true} {
		t.Run(strconv.FormatBool(withWitness), func(t *testing.T) {
			want := fixtureStripped
			if withWitness {
				want = fixtureFull
			}
			result := request(t, map[string]any{"op": "serialize", "transaction": fixture(), "include_witness": withWitness})
			expectStatus(t, result, "ok")
			if result["bytes"] != want || len(result) != 2 {
				t.Fatalf("unexpected serialization: %v, want %s", result, want)
			}
			for _, mode := range []string{"legacy", "witness"} {
				if withWitness && mode == "legacy" {
					continue
				}
				result = request(t, map[string]any{"op": "decode_exact", "bytes": want, "mode": mode})
				expectStatus(t, result, "ok")
				wantTx := fixture()
				if !withWitness {
					wantTx.Inputs[0].Witness = []string{}
				}
				if !reflect.DeepEqual(result["transaction"], wantTx) {
					t.Fatalf("decoded transaction: got %+v, want %+v", result["transaction"], wantTx)
				}
				if result["consumed"] != strconv.Itoa(len(want)/2) || len(result) != 3 {
					t.Fatalf("unexpected decode response: %v", result)
				}
			}
		})
	}
}

func TestEmptyTransaction(t *testing.T) {
	const encoding = "01000000000000000000"
	for _, witness := range []bool{false, true} {
		result := request(t, map[string]any{"op": "serialize", "transaction": emptyFixture(), "include_witness": witness})
		expectStatus(t, result, "ok")
		if result["bytes"] != encoding {
			t.Fatal(result)
		}
	}
	for _, mode := range []string{"legacy", "witness"} {
		result := request(t, map[string]any{"op": "decode_exact", "bytes": encoding, "mode": mode, "limits": map[string]string{"max_items": "0"}})
		expectStatus(t, result, "ok")
		if !reflect.DeepEqual(result["transaction"], emptyFixture()) {
			t.Fatal(result)
		}
	}
	identified := request(t, map[string]any{"op": "identify", "transaction": emptyFixture()})
	expectStatus(t, identified, "ok")
	if identified["stripped"] != encoding || identified["full"] != encoding || identified["stripped_size"] != "10" || identified["full_size"] != "10" {
		t.Fatal(identified)
	}
	if identified["txid_digest_order"] != identified["wtxid_digest_order"] {
		t.Fatal("no-witness identifiers differ")
	}
}

func TestPrefixAndExact(t *testing.T) {
	result := request(t, map[string]any{
		"op": "decode_prefix", "bytes": "deadbeef" + fixtureFull + fixtureStripped,
		"offset": "4", "mode": "witness",
	})
	expectStatus(t, result, "ok")
	if result["consumed"] != strconv.Itoa(len(fixtureFull)/2) || !reflect.DeepEqual(result["transaction"], fixture()) {
		t.Fatal(result)
	}
	result = request(t, map[string]any{"op": "decode_exact", "bytes": fixtureFull + "00", "mode": "witness"})
	expectStatus(t, result, "malformed_encoding")
	for _, offset := range []any{"-1", "1", "18446744073709551616", 0, nil} {
		result = request(t, map[string]any{"op": "decode_prefix", "bytes": "", "offset": offset, "mode": "legacy"})
		expectStatus(t, result, "invalid_request")
	}
	result = request(t, map[string]any{"op": "decode_prefix", "bytes": "00", "offset": "1", "mode": "legacy"})
	expectStatus(t, result, "malformed_encoding")
}

func TestCompactSizeBoundaries(t *testing.T) {
	vectors := []struct {
		n uint64
		h string
	}{
		{0, "00"}, {1, "01"}, {252, "fc"}, {253, "fdfd00"}, {65535, "fdffff"},
		{65536, "fe00000100"}, {4294967295, "feffffffff"}, {4294967296, "ff0000000001000000"},
		{unlimited, "ffffffffffffffffff"},
	}
	for _, vector := range vectors {
		b := fromHex(t, vector.h)
		if got := appendCompactSize(nil, vector.n); !bytes.Equal(got, b) {
			t.Fatalf("encoding %d: %x, want %x", vector.n, got, b)
		}
		if got := compactSizeLen(vector.n); got != uint64(len(b)) {
			t.Fatalf("size %d: %d", vector.n, got)
		}
		d := decoder{data: b, limit: unlimited}
		got, err := d.compactSize()
		if err != nil || got != vector.n || d.pos != len(b) {
			t.Fatalf("decoding %x: %d, %v", b, got, err)
		}
		for n := 0; n < len(b); n++ {
			d := decoder{data: b[:n], limit: unlimited}
			if _, err := d.compactSize(); !errors.Is(err, errMalformed) {
				t.Fatalf("truncated CompactSize %x: %v", b[:n], err)
			}
		}
	}
	for _, h := range []string{"fd0000", "fdfc00", "fe00000000", "feffff0000", "ff0000000000000000", "ffffffffff00000000"} {
		d := decoder{data: fromHex(t, h), limit: unlimited}
		if _, err := d.compactSize(); !errors.Is(err, errMalformed) {
			t.Fatalf("noncanonical %s: %v", h, err)
		}
	}
}

func TestMalformedEncodings(t *testing.T) {
	for _, h := range []string{fixtureStripped, fixtureFull} {
		b := fromHex(t, h)
		for n := 0; n < len(b); n++ {
			_, _, err := decode(b[:n], true, unlimited)
			if !errors.Is(err, errMalformed) {
				t.Fatalf("truncation at %d/%d: %v", n, len(b), err)
			}
		}
	}
	invalid := []string{
		"01000000fd00000000000000",                       // noncanonical input count
		"01000000ffffffffffffffffff",                     // enormous input count
		"0100000000ffffffffffffffffff",                   // enormous output count (legacy)
		"020000800001" + fixtureBody + "00" + "04030201", // superfluous witness framing
		"010000000001000000000000",                       // witness framing with no inputs
	}
	for _, flags := range []string{"02", "03", "80", "ff"} {
		invalid = append(invalid, "0200008000"+flags+fixtureBody+"030002aabb010004030201")
	}
	for i, h := range invalid {
		mode := "witness"
		if i == 2 {
			mode = "legacy"
		}
		result := request(t, map[string]any{"op": "decode_exact", "bytes": h, "mode": mode})
		expectStatus(t, result, "malformed_encoding")
	}
	// A zero-input, one-output legacy encoding is meaningful only in legacy
	// mode; witness mode interprets its first two counts as marker and flag.
	const noInputs = "01000000000100000000000000000000000000"
	for _, mode := range []string{"legacy", "witness"} {
		result := request(t, map[string]any{"op": "decode_exact", "bytes": noInputs, "mode": mode})
		want := "ok"
		if mode == "witness" {
			want = "malformed_encoding"
		}
		expectStatus(t, result, want)
	}
}

func TestWitnessPresence(t *testing.T) {
	tx := fixture()
	tx.Inputs[0].Witness = []string{}
	tx.Inputs = append(tx.Inputs, tx.Inputs[0])
	tx.Inputs[1].Witness = []string{""}
	result := request(t, map[string]any{"op": "serialize", "transaction": tx, "include_witness": true})
	expectStatus(t, result, "ok")
	full := result["bytes"].(string)
	if !strings.HasPrefix(full, "02000080000102") || !strings.HasSuffix(full, "00010004030201") {
		t.Fatalf("missing empty-stack or empty-item framing: %s", full)
	}
	decoded := request(t, map[string]any{"op": "decode_exact", "bytes": full, "mode": "witness"})
	expectStatus(t, decoded, "ok")
	if !reflect.DeepEqual(decoded["transaction"], tx) {
		t.Fatal(decoded)
	}
}

func TestIdentify(t *testing.T) {
	// Standard double-SHA256 of the empty byte string verifies both hashing
	// passes independently of transaction serialization.
	const doubleEmpty = "5df6e0e2761359d30a8275058e299fcc0381534545f55cf43e41983f5d4c9456"
	direct, display := digestOrders(nil)
	if direct != doubleEmpty {
		t.Fatalf("double SHA256: %s", direct)
	}
	b := fromHex(t, display)
	for i := range b {
		if b[i] != fromHex(t, doubleEmpty)[31-i] {
			t.Fatal("display order was not reversed")
		}
	}
	result := request(t, map[string]any{"op": "identify", "transaction": fixture()})
	expectStatus(t, result, "ok")
	if len(result) != 9 || result["stripped"] != fixtureStripped || result["full"] != fixtureFull ||
		result["stripped_size"] != strconv.Itoa(len(fixtureStripped)/2) || result["full_size"] != strconv.Itoa(len(fixtureFull)/2) {
		t.Fatal(result)
	}
	txid, txidDisplay := digestOrders(fromHex(t, fixtureStripped))
	wtxid, wtxidDisplay := digestOrders(fromHex(t, fixtureFull))
	if result["txid_digest_order"] != txid || result["txid_display_order"] != txidDisplay ||
		result["wtxid_digest_order"] != wtxid || result["wtxid_display_order"] != wtxidDisplay || txid == wtxid {
		t.Fatal(result)
	}
	tx := fixture()
	tx.Inputs[0].Witness = []string{"1234"}
	modified := request(t, map[string]any{"op": "identify", "transaction": tx})
	expectStatus(t, modified, "ok")
	if result["txid_digest_order"] != modified["txid_digest_order"] || result["wtxid_digest_order"] == modified["wtxid_digest_order"] {
		t.Fatal("witness mutation affected incorrect identifiers")
	}
}

func TestLimits(t *testing.T) {
	for _, op := range []string{"serialize", "identify", "decode_exact", "decode_prefix"} {
		for _, limit := range []string{"0", "1", "2", "3", "18446744073709551615"} {
			r := map[string]any{
				"op": op, "transaction": fixture(), "include_witness": false,
				"bytes": fixtureFull, "offset": "0", "mode": "witness",
				"limits": map[string]string{"max_items": limit},
			}
			result := request(t, r)
			want := "ok"
			if limit == "0" || limit == "1" || limit == "2" {
				want = "resource_limit"
			}
			expectStatus(t, result, want)
		}
	}
	for _, h := range []string{
		"01000000ffffffffffffffffff",                                   // input count
		"0100000000ffffffffffffffffff",                                 // output count
		"0100000001" + strings.Repeat("00", 36) + "ffffffffffffffffff", // input script
	} {
		result := request(t, map[string]any{"op": "decode_exact", "bytes": h, "mode": "legacy", "limits": map[string]string{"max_items": "10"}})
		expectStatus(t, result, "malformed_encoding")
	}
	for _, limits := range []any{nil, "", []any{}, map[string]any{"max_items": nil}, map[string]any{"max_items": 1}, map[string]string{"max_items": "-1"}, map[string]string{"max_items": "18446744073709551616"}} {
		result := request(t, map[string]any{"op": "identify", "transaction": emptyFixture(), "limits": limits})
		expectStatus(t, result, "invalid_request")
	}
	result := request(t, map[string]any{"op": "identify", "transaction": emptyFixture(), "limits": map[string]any{}})
	expectStatus(t, result, "ok")
}

func TestInvalidRequests(t *testing.T) {
	for _, raw := range []string{
		"", " ", "null", "[]", "42", "true", "{}", "{", "{}{}", `{"op":null}`,
		`{"op":"unknown"}`, `{"op":"serialize"}`, `{"op":"identify","transaction":null}`,
		`{"op":"decode_exact","bytes":"","mode":false}`,
		`{"op":"decode_exact","bytes":"","mode":"other"}`,
		`{"op":"decode_exact","bytes":"0","mode":"legacy"}`,
		`{"op":"decode_exact","bytes":"zz","mode":"legacy"}`,
		`{"op":"decode_exact","bytes":null,"mode":"legacy"}`,
		`{"op":"decode_prefix","bytes":"","mode":"legacy"}`,
	} {
		t.Run(raw, func(t *testing.T) { expectStatus(t, handleLine([]byte(raw)), "invalid_request") })
	}
	for _, field := range []string{"version_bits", "locktime", "inputs", "outputs"} {
		for _, value := range []any{nil, true, 1} {
			raw, _ := json.Marshal(emptyFixture())
			var tx map[string]any
			_ = json.Unmarshal(raw, &tx)
			tx[field] = value
			expectStatus(t, request(t, map[string]any{"op": "identify", "transaction": tx}), "invalid_request")
		}
	}
	for _, value := range []string{"-1", "+1", "", "1.0", " 1", "1 ", "4294967296"} {
		tx := emptyFixture()
		tx.VersionBits = value
		expectStatus(t, request(t, map[string]any{"op": "identify", "transaction": tx}), "invalid_request")
	}
	for _, value := range []any{nil, "true", 1} {
		expectStatus(t, request(t, map[string]any{"op": "serialize", "transaction": emptyFixture(), "include_witness": value}), "invalid_request")
	}
	mutations := []func(*transactionJSON){
		func(tx *transactionJSON) { tx.Inputs[0].PreviousTxidDigestOrder = strings.Repeat("00", 31) },
		func(tx *transactionJSON) { tx.Inputs[0].PreviousTxidDigestOrder = strings.Repeat("00", 33) },
		func(tx *transactionJSON) { tx.Inputs[0].PreviousIndex = "4294967296" },
		func(tx *transactionJSON) { tx.Inputs[0].Sequence = "-1" },
		func(tx *transactionJSON) { tx.Inputs[0].Script = "f" },
		func(tx *transactionJSON) { tx.Inputs[0].Witness = nil },
		func(tx *transactionJSON) { tx.Inputs[0].Witness = []string{"zz"} },
		func(tx *transactionJSON) { tx.Outputs[0].Amount = "18446744073709551616" },
		func(tx *transactionJSON) { tx.Outputs[0].Amount = "-9223372036854775809" },
		func(tx *transactionJSON) { tx.Outputs[0].Script = "0x00" },
	}
	for i, mutate := range mutations {
		t.Run(fmt.Sprintf("field%d", i), func(t *testing.T) {
			tx := fixture()
			mutate(&tx)
			expectStatus(t, request(t, map[string]any{"op": "identify", "transaction": tx}), "invalid_request")
		})
	}
}

