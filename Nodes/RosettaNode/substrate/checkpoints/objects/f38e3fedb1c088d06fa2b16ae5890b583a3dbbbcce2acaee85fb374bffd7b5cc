        self.server.stop()
        with Disk(self.server.db, writable=True) as db: db.mutate({}, ['meta/bytes'])
        second = subprocess.run([BINARY, str(self.server.db), str(self.server.socket)], capture_output=True, timeout=10)
        self.assertNotEqual(second.returncode, 0); self.assertIn(b'CorruptDatabase', second.stderr)
    def test_10_fragmented_and_large_lines(self):
        with self.server.connect() as cl:
            request = json.dumps(dict(request='fragment', op='evaluate', items=[ITEM])).encode() + b'\n'
            for byte in request: cl.sock.sendall(bytes([byte]))
            self.assertEqual(cl.response()['request'], 'fragment')
            # Greater than the adapter aggregate maximum, but below the JSON line cap.
            r = cl.call('submit', id='big', items=[{**ITEM, 'hex': '00' * ((16 << 20) + 1)}])
            self.assertEqual(r['status'], 'invalid_request')
        with self.server.connect() as cl:
            cl.sock.sendall(b' ' * ((40 << 20) + 1) + b'\n')
            self.assertEqual(cl.response()['status'], 'invalid_request')
        self.server.stop(); rows, _ = inspect(self.server.db); self.assertEqual(rows['meta/sequence'], '0')
    def test_11_outstanding_count_backpressure(self):
        with self.server.connect() as cl:
            requests = [dict(request=str(j), op='submit', id=f'capacity{j}', items=[ITEM]) for j in range(1800)]
            cl.send(requests)
            replies = [cl.response() for _ in requests]
            self.assertEqual([r['request'] for r in replies], [str(j) for j in range(1800)])
            accepted = [r for r in replies if r['status'] == 'accepted']
            pressured = [r for r in replies if r['status'] == 'backpressure']
            self.assertTrue(pressured, 'pipeline must exercise the outstanding count bound')
            self.assertEqual(len(accepted) + len(pressured), 1800)
            self.assertEqual([int(r['sequence']) for r in accepted], list(range(1, len(accepted) + 1)))
            # Retrying an existing id is not new admission, including at capacity.
            self.assertEqual(cl.call('submit', id='capacity0', items=[ITEM])['status'], 'existing')
        self.server.stop(); rows, jobs = inspect(self.server.db)
        self.assertEqual(len(jobs), len(accepted)); self.assertEqual(rows['meta/jobs'], '0')
    def test_12_acknowledged_cancel_survives_crash(self):
        for round_no in range(4):
            name = f'durable_cancel{round_no}'
            with self.server.connect() as cl:
                cl.send([dict(request='s', op='submit', id=name, items=[ITEM]), dict(request='c', op='cancel', id=name)])
                self.assertEqual(cl.response()['status'], 'accepted')
                self.assertEqual(cl.response()['status'], 'ok')
                self.server.kill()
            rows, jobs = inspect(self.server.db)
            job = jobs[name]
            if 'state' in job: self.assertEqual(job['state'], 'cancelled')
            else: self.assertEqual(rows[f"c/{int(job['sequence']):020d}"], '1')
            self.server.start()
        self.server.stop(); _, jobs = inspect(self.server.db)
        self.assertTrue(all(j['state'] == 'cancelled' for j in jobs.values()))
    def test_13_nonreading_peer_and_evaluate_order(self):
        with self.server.connect() as slow:
            self.assertEqual(slow.call('submit', id='slow', items=[ITEM])['status'], 'accepted')
            while slow.call('status', id='slow')['job']['state'] != 'complete': pass
            slow.send([dict(request=str(j), op='status', id='slow') for j in range(5000)])
            # Leave the several-megabyte response stream unread while another client progresses.
            with self.server.connect() as cl:
                cl.send([dict(request='a', op='evaluate', items=[ITEM]), dict(request='b', op='submit', id='other', items=[ITEM]),
                         dict(request='c', op='status', id='other')])
                responses = [cl.response() for _ in range(3)]
                self.assertEqual([r['request'] for r in responses], ['a', 'b', 'c'])
                self.assertEqual([r['status'] for r in responses], ['ok', 'accepted', 'ok'])
            self.server.stop()
        _, jobs = inspect(self.server.db)
        self.assertEqual(jobs['other']['state'], 'complete')

