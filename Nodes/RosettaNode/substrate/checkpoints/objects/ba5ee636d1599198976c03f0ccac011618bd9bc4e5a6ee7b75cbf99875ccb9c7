class ServiceTests(unittest.TestCase):
    def setUp(self):
        self.root = Path(tempfile.mkdtemp(prefix='v1-test-', dir=ROOT / 'tmp'))
        self.services = []

    def tearDown(self):
        for service in self.services:
            if service.p.poll() is None:
                service.kill()

    def start(self, name='run'):
        s = Service(self.root, name)
        self.services.append(s)
        return s

    def test_evaluate_native_equivalence(self):
        s = self.start()
        native = Native()
        fixtures = [ITEM, {**ITEM, 'hex': ''}, {**ITEM, 'hex': '00'},
                    {**ITEM, 'mode': 'legacy'}, {**ITEM, 'hex': ITEM['hex'] + '1234', 'operation': 'prefix'},
                    {**ITEM, 'hex': ITEM['hex'] + '1234'}, {**ITEM, 'hex': '01000000ff'}]
        rng = random.Random(42)
        fixtures += [{**ITEM, 'hex': rng.randbytes(n).hex(), 'mode': mode, 'operation': op}
                     for n in [0, 1, 9, 10, 31, 100, 1000]
                     for mode in ['legacy', 'witness'] for op in ['prefix', 'exact']]
        with s.connect() as cl:
            for items in [fixtures, [ITEM] * 64, [{**ITEM, 'hex': ''}]]:
                r = cl.call('evaluate', items=items)
                self.assertEqual(r['status'], 'ok')
                self.assertEqual(r['results'], native.evaluate(items))
        s.stop()
        rows, _ = inspect(s.db)
        self.assertEqual(rows['meta/sequence'], '0')

    def test_protocol_retry_events_and_reopen(self):
        s = self.start()
        with s.connect() as cl:
            self.assertEqual(cl.call('status', id='missing')['status'], 'not_found')
            self.assertEqual(cl.call('cancel', id='missing')['status'], 'not_found')
            cl.send({'request': 'one', 'op': 'submit', 'id': 'A_-9', 'items': [ITEM]})
            ack = cl.line()
            self.assertEqual(ack, {'request': 'one', 'status': 'accepted', 'sequence': '1'})
            event = cl.line()
            self.assertEqual(event['event'], 'terminal')
            self.assertEqual(event['job']['digest'], digest([ITEM]))
            self.assertEqual(event['job']['results'], Native().evaluate([ITEM]))
            self.assertEqual(cl.call('submit', id='A_-9', items=[ITEM])['status'], 'existing')
            self.assertEqual(cl.call('submit', id='A_-9', items=[{**ITEM, 'mode': 'legacy'}])['status'], 'conflict')
            self.assertEqual(cl.call('cancel', id='A_-9')['status'], 'too_late')
            receipt = cl.call('status', id='A_-9')['job']
            self.assertEqual(receipt, event['job'])
        s.stop()
        rows, jobs = inspect(s.db)
        self.assertEqual(rows['meta/checkpoint'], '1')
        self.assertEqual(jobs['A_-9'], receipt)
        s = self.start('reopen')
        with s.connect() as cl:
            self.assertEqual(cl.call('status', id='A_-9')['job'], receipt)
            self.assertEqual(cl.call('submit', id='A_-9', items=[ITEM])['sequence'], '1')
        s.stop()

    def test_invalid_requests_leave_no_rows(self):
        s = self.start()
        with s.connect() as cl:
            bad = [dict(op='submit', id='', items=[ITEM]), dict(op='submit', id='a/b', items=[ITEM]),
                   dict(op='submit', id='a' * 65, items=[ITEM]), dict(op='evaluate', items=[]),
                   dict(op='evaluate', items=[ITEM] * 65), dict(op='submit', id='bad', items=[{**ITEM, 'hex':'AA'}]),
                   dict(op='evaluate', items=[{**ITEM, 'hex':'0'}]), dict(op='evaluate', items=[{**ITEM, 'mode':'bad'}]),
                   dict(op='evaluate', items=[{**ITEM, 'operation':'bad'}]), dict(op='evaluate', items=[None]),
                   dict(op='submit', id='bad', items=[ITEM], priority='high'), dict(op='bogus'),
                   dict(op='status', id=12), dict(op='evaluate', items=[{**ITEM, 'extra':1}])]
            for q in bad:
                self.assertEqual(cl.call(**q)['status'], 'invalid_request', q)
            for raw in [b'{}\n', b'[]\n', b'{"request":"a","request":"b","op":"shutdown"}\n',
                        b'{"request":"a","op":"shutdown"} trailing\n', b'\xff\n']:
                cl.s.sendall(raw)
                self.assertEqual(cl.line()['status'], 'invalid_request')
        s.stop()
        rows, jobs = inspect(s.db)
        self.assertEqual(len(rows), 5)
        self.assertEqual(jobs, {})

    def test_eight_clients_and_disconnect(self):
        s = self.start()
        barrier = threading.Barrier(8)
        def client(n):
            with s.connect() as cl:
                barrier.wait(timeout=10)
                accepted = []
                for i in range(30):
                    ident = f'c{n}_{i}'
                    r = cl.call('submit', id=ident, items=[ITEM])
                    self.assertEqual(r['status'], 'accepted')
                    accepted.append((ident, r['sequence']))
                    if i % 7 == 0:
                        self.assertEqual(cl.call('submit', id=ident, items=[ITEM])['status'], 'existing')
                return accepted
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
            admitted = sum(list(ex.map(client, range(8))), [])
        # All submitters disappear; their work must remain durable and finish.
        s.stop()
        rows, jobs = inspect(s.db)
        self.assertEqual(rows['meta/checkpoint'], '240')
        self.assertEqual(set(jobs), {x[0] for x in admitted})
        for ident, seq in admitted:
            self.assertEqual(jobs[ident]['sequence'], seq)

    def test_pending_recovery_cancellation_and_order(self):
        cancelled = set(range(3, 1025, 3))
        seed(self.root / 'db', 1024, cancelled)
        s = self.start()
        with s.connect() as cl:
            r = cl.call('cancel', id='seed_1024')
            self.assertEqual(r['status'], 'ok')
            self.assertEqual(cl.call('cancel', id='seed_1024')['status'], 'ok')
            self.assertEqual(cl.call('status', id='seed_1024')['job']['state'], 'cancel_pending')
            self.assertEqual(cl.call('submit', id='seed_1024', items=[ITEM])['status'], 'existing')
        cancelled.add(1024)
        s.stop()
        rows, jobs = inspect(s.db)
        self.assertEqual(rows['meta/checkpoint'], '1024')
        for n in range(1, 1025):
            self.assertEqual(jobs[f'seed_{n}']['state'], 'cancelled' if n in cancelled else 'complete')

    def test_exclusive_writer_and_bad_schema(self):
        s = self.start()
        other = subprocess.run([str(BINARY), str(s.db), str(self.root / 'second.sock')], capture_output=True, timeout=10)
        self.assertNotEqual(other.returncode, 0)
        self.assertIn(b'lock', other.stderr.lower())
        with s.connect() as cl:
            self.assertEqual(cl.call('submit', id='kept', items=[ITEM])['status'], 'accepted')
        s.stop()
        with Rocks(s.db) as db:
            db.batch({'meta/version':'2'})
            before = db.rows()
        bad = subprocess.run([str(BINARY), str(s.db), str(self.root / 'bad.sock')], capture_output=True, timeout=10)
        self.assertNotEqual(bad.returncode, 0)
        with Rocks(s.db) as db:
            self.assertEqual(db.rows(), before)

    def test_crash_histories_and_restart(self):
        for trial in range(4):
            if trial:
                self.root = Path(tempfile.mkdtemp(prefix='v1-crash-', dir=ROOT / 'tmp'))
            s = self.start()
            acknowledged = {}
            cancelled = set()
            with s.connect() as cl:
                for n in range(24):
                    ident = f'crash_{n}'
                    r = cl.call('submit', id=ident, items=[ITEM])
                    self.assertEqual(r['status'], 'accepted')
                    acknowledged[ident] = r['sequence']
                    if n % 3 == 0 and cl.call('cancel', id=ident)['status'] == 'ok':
                        cancelled.add(ident)
                # Send additional work without waiting for responses; crash timing
                # may leave any complete prefix of these admissions on disk.
                burst = b''.join(json.dumps({'request': f'flight{n}', 'op':'submit', 'id':f'flight{n}', 'items':[ITEM]}).encode() + b'\n' for n in range(100))
                cl.s.sendall(burst)
                time.sleep([0, .001, .005, .02][trial])
                s.kill()
            _, jobs = inspect(s.db)
            for ident, seq in acknowledged.items():
                self.assertEqual(jobs[ident]['sequence'], seq)
            s = self.start('restart')
            s.stop()
            rows, final = inspect(s.db)
            self.assertEqual(rows['meta/checkpoint'], rows['meta/sequence'])
            self.assertEqual(set(final), set(jobs))
            for ident in cancelled:
                self.assertEqual(final[ident]['state'], 'cancelled')

