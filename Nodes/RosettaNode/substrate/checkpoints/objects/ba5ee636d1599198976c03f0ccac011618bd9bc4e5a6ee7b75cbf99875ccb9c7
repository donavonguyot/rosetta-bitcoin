    def test_nonempty_witness_and_item_resource_boundary(self):
        # Byte fixtures only. All parsing/encoding remains in the supplied kernel.
        vin = '01' + '00' * 32 + 'ffffffff' + '0151' + 'ffffffff'
        vout = '01' + '0100000000000000' + '0151'
        legacy = '01000000' + vin + vout + '00000000'
        witness = '01000000' + '0001' + vin + vout + '010100' + '00000000'
        limited = '01000000' + vin + 'fd0010' + '000000000000000000' * 4096 + '00000000'
        within = '01000000' + vin + 'fdff0f' + '000000000000000000' * 4095 + '00000000'
        items = [{**ITEM, 'hex':legacy, 'mode':'legacy'}, {**ITEM, 'hex':witness},
                 {**ITEM, 'hex':witness + 'deadbeef', 'operation':'prefix'},
                 {**ITEM, 'hex':limited, 'mode':'legacy'}, {**ITEM, 'hex':within, 'mode':'legacy'}]
        expected = Native().evaluate(items)
        self.assertEqual([r['status'] for r in expected], ['0', '0', '0', '2', '0'])
        self.assertEqual(expected[0]['txid_digest_order'], expected[1]['txid_digest_order'])
        self.assertNotEqual(expected[1]['txid_digest_order'], expected[1]['wtxid_digest_order'])
        self.assertEqual(expected[2]['consumed'], str(len(witness) // 2))
        s = self.start()
        with s.connect() as cl:
            self.assertEqual(cl.call('evaluate', items=items)['results'], expected)
            self.assertEqual(cl.call('submit', id='mixed', items=items)['status'], 'accepted')
        s.stop()
        _, jobs = inspect(s.db)
        self.assertEqual(jobs['mixed']['results'], expected)

