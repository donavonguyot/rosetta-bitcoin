    def test_fragmented_pipelined_and_opaque_correlation(self):
        s = self.start()
        with s.connect() as cl:
            correlation = 'quotes"\\\n snowman \u2603 , : {} []'
            requests = [{'request': correlation, 'op': 'submit', 'id':'fragmented', 'items':[ITEM]},
                        {'request': '', 'op': 'status', 'id':'fragmented'},
                        {'request': 'last', 'op': 'evaluate', 'items':[ITEM]}]
            data = b''.join(json.dumps(q).encode() + b'\n' for q in requests)
            for start in range(0, len(data), 17):
                cl.s.sendall(data[start:start+17])
            responses = []
            while len(responses) < 3:
                r = cl.line()
                if 'event' not in r:
                    responses.append(r)
                else:
                    self.assertTrue(responses, 'terminal event preceded admission acknowledgment')
            self.assertEqual([r['request'] for r in responses], [correlation, '', 'last'])
            self.assertEqual([r['status'] for r in responses], ['accepted', 'ok', 'ok'])
        s.stop()

    def test_large_requests_and_adapter_byte_limits(self):
        s = self.start()
        native = Native()
        with s.connect() as cl:
            # Kernel resource/admission limits are returned as item results.
            for size in [(4 << 20), (4 << 20) + 1, (16 << 20)]:
                items = [{**ITEM, 'hex': '00' * size}]
                r = cl.call('evaluate', items=items)
                self.assertEqual(r['status'], 'ok')
                self.assertEqual(r['results'], native.evaluate(items))
            self.assertEqual(cl.call('evaluate', items=[{**ITEM, 'hex':'00' * ((16 << 20) + 1)}])['status'], 'invalid_request')
            self.assertEqual(cl.call('submit', id='large', items=[{**ITEM, 'hex':'00' * (4 << 20)}])['status'], 'accepted')
        s.stop()
        _, jobs = inspect(s.db)
        self.assertEqual(jobs['large']['digest'], digest([{**ITEM, 'hex':'00' * (4 << 20)}]))

    def test_request_text_boundary_and_deep_invalid_json(self):
        s = self.start()
        with s.connect() as cl:
            base = b'{"request":"limit","op":"status","id":"missing"}'
            cl.s.sendall(base + b' ' * ((40 << 20) - len(base)) + b'\n')
            self.assertEqual(cl.line(), {'request':'limit','status':'not_found'})
            cl.s.sendall(b'{"request":"deep","op":"evaluate","items":' + b'[' * 10000 + b']' * 10000 + b'}\n')
            self.assertEqual(cl.line()['status'], 'invalid_request')
        with s.connect() as cl:
            # Oversized line is rejected and the connection is then closed.
            try:
                cl.s.sendall(b' ' * ((40 << 20) + 1) + b'\n')
            except (BrokenPipeError, ConnectionResetError):
                pass
            self.assertEqual(cl.line()['status'], 'invalid_request')
        s.stop()
        rows, _ = inspect(s.db)
        self.assertEqual(rows['meta/sequence'], '0')

    def test_payload_backpressure_counts_uncommitted_work(self):
        # Empty jobs at the front retain a long ordered-commit prefix while four
        # completed large jobs at the back retain exactly the 64 MiB budget.
        rows = {'meta/version':'1', 'meta/sequence':'132', 'meta/checkpoint':'0',
                'meta/jobs':'132', 'meta/bytes':str(64 << 20)}
        for n in range(1, 133):
            items = [{**ITEM, 'hex':''}] if n <= 128 else [{**ITEM, 'hex':'00' * (4 << 20)}] * 4
            job = pending(n, items)
            rows[f'p/{n:020d}'] = json.dumps(job, separators=(',', ':'))
            rows['id/' + job['id']] = str(n)
        with Rocks(self.root / 'db', create=True) as db:
            db.batch(rows)
        del rows, items, job
        s = self.start()
        with s.connect() as cl:
            self.assertEqual(cl.call('submit', id='full', items=[ITEM])['status'], 'backpressure')
            self.assertEqual(cl.call('submit', id='seed_128', items=[{**ITEM, 'hex':''}])['status'], 'existing')
            self.assertEqual(cl.call('cancel', id='seed_132')['status'], 'ok')
        s.stop()
        rows, jobs = inspect(s.db)
        self.assertNotIn('full', jobs)
        self.assertEqual(jobs['seed_132']['state'], 'cancelled')
        self.assertEqual(rows['meta/bytes'], '0')
        s = self.start('restart')
        with s.connect() as cl:
            self.assertEqual(cl.call('submit', id='full', items=[ITEM])['status'], 'accepted')
        s.stop()

    def test_recovery_refuses_corruption_without_rebuilding(self):
        changes = [ {'meta/jobs':'1'}, {'meta/checkpoint':'1'}, {'id/seed_2':None},
                    {'c/00000000000000000003':'1'}, {'meta/bytes':None},
                    {'p/00000000000000000001':json.dumps({**pending(1), 'digest':'0' * 64})} ]
        for i, change in enumerate(changes):
            root = self.root / str(i)
            root.mkdir()
            seed(root / 'db', 2)
            with Rocks(root / 'db') as db:
                db.batch(change)
                before = db.rows()
            proc = subprocess.run([str(BINARY), str(root / 'db'), str(root / 'sock')], capture_output=True, timeout=10)
            self.assertNotEqual(proc.returncode, 0, change)
            with Rocks(root / 'db') as db:
                self.assertEqual(db.rows(), before)

    def test_draining_rejects_new_work_but_preserves_retries(self):
        seed(self.root / 'db', 1024)
        s = self.start()
        with s.connect() as cl:
            self.assertEqual(cl.call('shutdown')['status'], 'draining')
            self.assertEqual(cl.call('submit', id='new', items=[ITEM])['status'], 'draining')
            self.assertEqual(cl.call('evaluate', items=[ITEM])['status'], 'draining')
            self.assertEqual(cl.call('submit', id='seed_1024', items=[ITEM])['status'], 'existing')
            self.assertEqual(cl.call('submit', id='seed_1024', items=[{**ITEM, 'mode':'legacy'}])['status'], 'conflict')
            self.assertEqual(cl.call('cancel', id='seed_1024')['status'], 'ok')
            self.assertEqual(cl.call('status', id='seed_1024')['job']['state'], 'cancel_pending')
        self.assertEqual(s.p.wait(timeout=30), 0)
        s.log.close()
        rows, jobs = inspect(s.db)
        self.assertEqual(rows['meta/checkpoint'], '1024')
        self.assertNotIn('new', jobs)
        self.assertEqual(jobs['seed_1024']['state'], 'cancelled')

    def test_job_count_backpressure_under_eight_clients(self):
        s = self.start()
        barrier = threading.Barrier(8)
        def client(n):
            with s.connect() as cl:
                barrier.wait(timeout=10)
                replies = []
                for i in range(350):
                    ident = f'pressure_{n}_{i}'
                    r = cl.call('submit', id=ident, items=[ITEM])
                    self.assertIn(r['status'], ('accepted', 'backpressure'))
                    replies.append((ident, r))
                return replies
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
            replies = sum(list(ex.map(client, range(8))), [])
        accepted = {ident: r for ident, r in replies if r['status'] == 'accepted'}
        denied = {ident for ident, r in replies if r['status'] == 'backpressure'}
        self.assertTrue(denied, 'workload did not reach the admission bound')
        s.stop()
        rows, jobs = inspect(s.db)
        self.assertEqual(set(jobs), set(accepted))
        self.assertTrue(set(jobs).isdisjoint(denied))
        self.assertEqual(int(rows['meta/sequence']), len(accepted))

