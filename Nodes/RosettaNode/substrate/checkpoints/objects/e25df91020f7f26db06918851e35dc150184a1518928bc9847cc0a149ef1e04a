import "C"

import (
	"encoding/hex"
	"fmt"
	"unsafe"
)

func nativeEvaluate(p *prepared) ([]Result, error) {
	n := len(p.Items)
	out := make([]C.rn_result, n)
	var data *C.uchar
	if len(p.Payload) != 0 {
		data = (*C.uchar)(unsafe.Pointer(&p.Payload[0]))
	}
	rc := C.verify_job(data, C.uint64_t(len(p.Payload)),
		(*C.uint64_t)(unsafe.Pointer(&p.Lengths[0])),
		(*C.uint32_t)(unsafe.Pointer(&p.Witness[0])),
		(*C.uint32_t)(unsafe.Pointer(&p.Exact[0])), C.uint64_t(n), &out[0])
	if rc != 0 {
		return nil, fmt.Errorf("native v1 call failed (%d; -2 means allocation failure)", int(rc))
	}
	results := make([]Result, n)
	for i := range out {
		r := &out[i]
		if r.status > 4 {
			return nil, fmt.Errorf("native returned unknown status %d", uint64(r.status))
		}
		results[i] = Result{Status: decimal(uint64(r.status)), Consumed: "0", FullSize: "0", StrippedSize: "0", TxID: zeroDigest, WtxID: zeroDigest}
		if r.status == 0 {
			results[i].Consumed = decimal(uint64(r.consumed))
			results[i].FullSize = decimal(uint64(r.full_size))
			results[i].StrippedSize = decimal(uint64(r.stripped_size))
			results[i].TxID = hex.EncodeToString(unsafe.Slice((*byte)(unsafe.Pointer(&r.txid[0])), 32))
			results[i].WtxID = hex.EncodeToString(unsafe.Slice((*byte)(unsafe.Pointer(&r.wtxid[0])), 32))
		}
	}
	return results, nil
}
