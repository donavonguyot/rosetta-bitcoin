func TestConcurrentRetriesAndCancellations(t *testing.T) {
	s, path := testService(t)
	s.start()
	p := preparedFixture(t)
	var wg sync.WaitGroup
	var mu sync.Mutex
	accepted := 0
	cancelled := map[string]bool{}
	for c := 0; c < 8; c++ {
		wg.Add(1)
		go func(c int) {
			defer wg.Done()
			if r, _ := s.submit(p, "shared", nil); r.Status == "accepted" {
				mu.Lock()
				accepted++
				mu.Unlock()
			} else if r.Status != "existing" {
				t.Error(r)
			}
			for i := 0; i < 24; i++ {
				id := fmt.Sprintf("%d-%d", c, i)
				if r, _ := s.submit(p, id, nil); r.Status != "accepted" {
					t.Error(r)
				}
				if s.cancel(id).Status == "ok" {
					mu.Lock()
					cancelled[id] = true
					mu.Unlock()
				}
			}
		}(c)
	}
	wg.Wait()
	if accepted != 1 {
		t.Fatal("duplicate admissions", accepted)
	}
	drainTest(t, s)
	rows := inspectStopped(t, path)
	for id := range cancelled {
		n, _ := parseDecimal(rows["id/"+id])
		var r Receipt
		json.Unmarshal([]byte(rows[sequenceKey("r", n)]), &r)
		if r.State != "cancelled" {
			t.Fatal("acknowledged cancellation lost", id)
		}
	}
}

func TestFourWorkersAndArenaLifetime(t *testing.T) {
	s, path := testService(t)
	p := preparedFixture(t)
	for i := 0; i < 5; i++ {
		s.submit(p, fmt.Sprint(i), nil)
	}
	// Arrange four in-flight calls using the real dispatch path. This makes
	// cancellation deterministic without adding a native barrier to the service.
	s.mu.Lock()
	var dispatched []*job
	for i := 0; i < 4; i++ {
		j := s.dispatchLocked()
		if j == nil || !j.running || j.prepared != p {
			t.Fatal("missing dispatch or payload")
		}
		dispatched = append(dispatched, j)
	}
	if s.dispatchLocked() != nil || len(s.queue) != 1 {
		t.Fatal("prefetched beyond four slots")
	}
	s.mu.Unlock()
	if s.cancel("0").Status != "ok" {
		t.Fatal("running cancellation")
	}
	s.mu.Lock()
	if s.pending[1].prepared != p || s.pending[1].done || s.checkpoint != 0 {
		t.Fatal("freed running arena/payload")
	}
	s.mu.Unlock()
	for _, j := range dispatched {
		results, err := nativeEvaluate(j.prepared)
		if err != nil {
			t.Fatal(err)
		}
		s.mu.Lock()
		j.running, j.done, j.results = false, true, results
		<-s.slots
		s.mu.Unlock()
	}
	s.start()
	drainTest(t, s)
	inspectStopped(t, path)
}

func TestRejectCorruptRecovery(t *testing.T) {
	for _, kind := range []string{"schema", "counter", "index", "digest", "missing", "priority"} {
		t.Run(kind, func(t *testing.T) {
			s, path := testService(t)
			s.submit(preparedFixture(t), "a", nil)
			b := storage.NewBatch()
			switch kind {
			case "schema":
				b.Put("meta/version", "2")
			case "counter":
				b.Put("meta/bytes", "11")
			case "index":
				b.Put("id/a", "2")
			case "digest":
				p := *s.pending[1].pending
				p.Digest = zeroDigest
				b.Put(sequenceKey("p", 1), marshal(&p))
			case "missing":
				b.Delete("meta/jobs")
			case "priority":
				p := *s.pending[1].pending
				p.Priority = "urgent"
				b.Put(sequenceKey("p", 1), marshal(&p))
			}
			if err := s.db.Write(b); err != nil {
				t.Fatal(err)
			}
			b.Close()
			s.db.Close()
			if reopened, err := openService(path); err == nil {
				reopened.db.Close()
				t.Fatal("accepted corrupt database")
			}
		})
	}
}

func TestDrainWaitsForResponseDelivery(t *testing.T) {
	s, path := testService(t)
	if !s.beginRequest() || !s.beginRequest() {
		t.Fatal("request start")
	}
	s.start()
	s.beginDrain()
	s.acknowledgeDrain()
	s.finishRequest()
	select {
	case <-s.drained:
		t.Fatal("closed before last outstanding response")
	case <-time.After(10 * time.Millisecond):
	}
	s.finishRequest()
	select {
	case <-s.drained:
	case <-time.After(5 * time.Second):
		t.Fatal("drain did not complete")
	}
	s.wg.Wait()
	s.db.Close()
	inspectStopped(t, path)
}
